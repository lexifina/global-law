{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lexifina/global-law/blob/main/manifest.schema.json",
  "title": "Git for Global Law: manifest.json",
  "description": "The shape tools/describe.py writes manifest.json in; tests/test_manifest_schema.py holds the file to it. A new field is added here first, then written.",
  "type": "object",
  "required": ["title", "scheme", "date_rule", "future_rule", "countries", "countries_rule", "countries_listed",
               "countries_catalogue_only", "countries_without_corpus", "awaiting_corpus_json", "corpora"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string"},
    "scheme": {"type": "string"},
    "date_rule": {"type": "string"},
    "future_rule": {"type": "string"},
    "countries": {"type": "integer", "minimum": 0},
    "countries_rule": {"type": "string"},
    "countries_listed": {"type": "integer", "minimum": 0},
    "countries_catalogue_only": {"$ref": "#/$defs/folders"},
    "countries_without_corpus": {"$ref": "#/$defs/folders"},
    "awaiting_corpus_json": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "not_pinned": {"type": "array", "items": {"type": "object"}},
    "corpora": {"type": "array", "items": {"$ref": "#/$defs/corpus"}}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*){2,3}$"},
    "folders": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "corpus": {
      "type": "object",
      "required": ["path", "url", "iso_path", "in_force_trailer", "described_by", "kind"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/path", "description": "country / level / [locality /] corpus"},
        "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"},
        "iso_path": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*){1,3}$",
                     "description": "the path with ISO codes, as the corpus names itself; an older path tools still resolve"},
        "code": {"type": "string", "pattern": "^[A-Z]{2,4}(-[A-Z0-9]+)*$", "description": "ISO 3166-1 or 3166-2 (or below); EU, EAEU for the unions"},
        "kind": {"enum": ["legislation", "judgments", "guidance"]},
        "name": {"type": "string"},
        "label": {"type": "string"},
        "language": {"type": "string"},
        "publisher": {"type": "string"},
        "coverage": {"type": "string"},
        "record_note": {"type": "string"},
        "history": {"enum": ["in-force", "replayed", "as-enacted", "current-only", "metadata-only"]},
        "history_from": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
        "record_to": {"$ref": "#/$defs/day"},
        "checked_on": {"$ref": "#/$defs/day"},
        "acts": {"type": "integer", "minimum": 0, "description": "how many acts; the list, where a corpus keeps one, is in its own corpus.json"},
        "selection": {"enum": ["all-acts", "selected-acts"]},
        "in_force_trailer": {"type": "string"},
        "baseline_trailer": {"type": "string"},
        "correction_trailer": {"type": "string"},
        "future_branch": {"type": "string", "description": "the branch tools/law.py reads laws not yet in force from"},
        "future_branch_unread": {"type": "string", "description": "a future branch the repository has that is not read"},
        "described_by": {"enum": ["corpus.json", "data/repo.json", "jurisdiction.json", "path"]},
        "derived": {"$ref": "#/$defs/strings"},
        "warnings": {"$ref": "#/$defs/strings"},
        "citation": {"type": "object"},
        "scope": {"type": "object", "description": "how the corpus's Applies: trailers read"},
        "overlay": {"type": "object"},
        "source": {"type": "object"},
        "freshness": {"type": "object"},
        "effects": {"type": "array"},
        "freshness_days": {"type": "integer", "minimum": 0},
        "tool": {"type": "string"},
        "verification": {"type": "string"},
        "provisional": {"type": "string"},
        "contract": {"type": "string"},
        "licence": {"type": "string"},
        "credit": {"type": "string"}
      }
    }
  }
}
