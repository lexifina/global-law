import KwGlobal.Other

/-! # Kuwait: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace KwGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := corporateUnsupported g ++ socialUnsupported g ++ payrollUnsupported g ++ zakatUnsupported g ++ customsUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry KwTax.country) with
    families := [corporate, zakat, customs], unsupported := unsupported, absent := consumptionAbsent ++ otherAbsent,
    notes := ["Kuwait 2025, kernel 2.0 (cmp20/global/R5/kw); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (KwTax.country.computeWith args c).toJson :=
  conservative_pit model KwTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end KwGlobal
