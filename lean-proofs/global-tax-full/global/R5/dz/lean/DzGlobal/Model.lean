/-! # Algeria: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace DzGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ capitalUnsupported g ++ socialUnsupported g ++ propertyUnsupported g ++ transfersUnsupported g ++ wealthUnsupported g ++ vehiclesUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry DzTax.country) with
    families := [consumption, corporate, capital, property, transfers, wealth, vehicles], unsupported := unsupported, absent := otherAbsent,
    notes := ["Algeria 2025, kernel 2.0 (cmp20/global/R5/dz); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (DzTax.country.computeWith args c).toJson :=
  conservative_pit model DzTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end DzGlobal
