import LyTax.Legacy
import TaxKernel.Global
import LyGlobal.Corporate
import LyGlobal.Social
import LyGlobal.Transfers
import LyGlobal.Other

/-! # Libya: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace LyGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := corporateUnsupported g ++ socialUnsupported g ++ transfersUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry LyTax.country) with
    families := [corporate, transfers], unsupported := unsupported, absent := otherAbsent,
    notes := ["Libya 2025, kernel 2.0 (cmp20/global/R5/ly); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (LyTax.country.computeWith args c).toJson :=
  conservative_pit model LyTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end LyGlobal
