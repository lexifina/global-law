/-! # Armenia: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace AmGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ capitalUnsupported g ++ propertyUnsupported g ++ transfersUnsupported g ++ wealthUnsupported g ++ vehiclesUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry AmTax.country) with
    families := [consumption, corporate, capital, property, transfers, wealth, vehicles], unsupported := unsupported, absent := otherAbsent,
    notes := ["Armenia 2025, kernel 2.0 (cmp20/global/R5/am); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (AmTax.country.computeWith args c).toJson :=
  conservative_pit model AmTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end AmGlobal
