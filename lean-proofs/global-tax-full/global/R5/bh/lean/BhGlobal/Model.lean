import BhTax.Legacy
import TaxKernel.Global
import BhGlobal.Consumption
import BhGlobal.Corporate
import BhGlobal.Social
import BhGlobal.Payroll
import BhGlobal.Transfers
import BhGlobal.Customs
import BhGlobal.Other

/-! # Bahrain: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace BhGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ socialUnsupported g ++ payrollUnsupported g ++ transfersUnsupported g ++ customsUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry BhTax.country) with
    families := [consumption, corporate, social, payroll, transfers, customs], unsupported := unsupported, absent := otherAbsent,
    notes := ["Bahrain 2025, kernel 2.0 (cmp20/global/R5/bh); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (BhTax.country.computeWith args c).toJson :=
  conservative_pit model BhTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end BhGlobal
