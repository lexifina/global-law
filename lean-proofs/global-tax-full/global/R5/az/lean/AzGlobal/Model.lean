import AzTax.Legacy
import TaxKernel.Global
import AzGlobal.Consumption
import AzGlobal.Corporate
import AzGlobal.Capital
import AzGlobal.Social
import AzGlobal.Property
import AzGlobal.Transfers
import AzGlobal.Vehicles
import AzGlobal.Other

/-! # Azerbaijan: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace AzGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ capitalUnsupported g ++ propertyUnsupported g ++ transfersUnsupported g ++ vehiclesUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry AzTax.country) with
    families := [consumption, corporate, capital, social, property, transfers, vehicles], unsupported := unsupported, absent := otherAbsent,
    notes := ["Azerbaijan 2025, kernel 2.0 (cmp20/global/R5/az); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (AzTax.country.computeWith args c).toJson :=
  conservative_pit model AzTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end AzGlobal
