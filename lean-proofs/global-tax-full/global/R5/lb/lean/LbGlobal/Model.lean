import LbTax.Legacy
import TaxKernel.Global
import LbGlobal.Consumption
import LbGlobal.Corporate
import LbGlobal.Social
import LbGlobal.Payroll
import LbGlobal.Transfers
import LbGlobal.Other

/-! # Lebanon: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace LbGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ socialUnsupported g ++ payrollUnsupported g ++ transfersUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry LbTax.country) with
    families := [consumption, corporate, social, transfers], unsupported := unsupported, absent := otherAbsent,
    notes := ["Lebanon 2025, kernel 2.0 (cmp20/global/R5/lb); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (LbTax.country.computeWith args c).toJson :=
  conservative_pit model LbTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end LbGlobal
