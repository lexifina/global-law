import PsTax.Legacy
import TaxKernel.Global
import PsGlobal.Consumption
import PsGlobal.Corporate
import PsGlobal.Payroll
import PsGlobal.Property
import PsGlobal.Other

/-! # Palestine: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace PsGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ payrollUnsupported g ++ propertyUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry PsTax.country) with
    families := [consumption, corporate, property], unsupported := unsupported, absent := otherAbsent,
    notes := ["Palestine 2025, kernel 2.0 (cmp20/global/R5/ps); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (PsTax.country.computeWith args c).toJson :=
  conservative_pit model PsTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end PsGlobal
