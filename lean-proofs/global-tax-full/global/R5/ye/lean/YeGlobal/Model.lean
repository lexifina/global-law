/-! # Yemen: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace YeGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ socialUnsupported g ++ payrollUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry YeTax.country) with
    families := [], unsupported := unsupported, absent := otherAbsent,
    notes := ["Yemen 2025, kernel 2.0 (cmp20/global/R5/ye); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (YeTax.country.computeWith args c).toJson :=
  conservative_pit model YeTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end YeGlobal
