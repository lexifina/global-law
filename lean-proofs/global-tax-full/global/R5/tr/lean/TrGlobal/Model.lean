/-! # Türkiye: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace TrGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ socialUnsupported g ++ payrollUnsupported g ++ transfersUnsupported g ++ wealthUnsupported g ++ vehiclesUnsupported g ++ customsUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry TrTax.country) with
    families := [consumption, corporate, social, payroll, transfers, wealth, vehicles, customs], unsupported := unsupported, absent := otherAbsent,
    notes := ["Türkiye 2025, kernel 2.0 (cmp20/global/R5/tr); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (TrTax.country.computeWith args c).toJson :=
  conservative_pit model TrTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end TrGlobal
