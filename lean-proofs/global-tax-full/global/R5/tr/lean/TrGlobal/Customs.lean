def customs : Family := customsFamily [tariff] "5123 customs import duty (WTO IDB 2025)"

/-- Imported lines whose duty the tariff cannot settle (kernel `TariffRule.unknown`: grade C). -/
def customsUnsupported (g : CanonGlobal) : List String := tariff.unknown g

def custT (s : String) : CanonGlobal :=
  match Json.parse s with
  | .ok j => (match parseGlobal j with | .ok g => g | .error _ => default)
  | .error _ => default

-- clothing (hs 610910) from CN (no preference): customs value 12345, MFN 51 % = 12345 x 5100 / 10000 = 6295
#guard (tariff.charges (custT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"consumption\":[{\"good\":\"clothing\",\"amount\":24690,\"hs\":\"610910\",\"origin\":\"CN\",\"customsValue\":12345}]}")).map (·.due) == [6295]
-- food (hs 090121) from AT: EU - Türkiye free trade agreement; United Kingdom - Türkiye free trade agreement 15 % instead of MFN 17 %: 12345 x 1500 / 10000 = 1851
#guard (tariff.charges (custT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"consumption\":[{\"good\":\"food\",\"amount\":24690,\"hs\":\"090121\",\"origin\":\"AT\",\"customsValue\":12345}]}")).map (·.due) == [1851]
-- imported without hs: no charge (grade C line)
#guard (tariff.charges (custT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"consumption\":[{\"good\":\"clothing\",\"amount\":24690,\"imported\":true}]}")).map (·.due) == []

