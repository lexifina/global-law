import AeTax.Basic

/-! L1 loophole round (Africa / Middle East, 2026-11-20): the #guards behind FINDINGS.md "Verification".
Each guard runs `AeTax.country` on a contract household (the JSON line the exe reads) and checks a figure or the
difference between two households. Generated by world/loopholes/africa_mena/vgen.py from checks/AE.json. -/

namespace AeTax.Verify
open TaxKernel Lean

def outOf (args : List String) (s : String) : Except String (Out × Canon) := do
  let j ← Json.parse s
  let c ← parseCanon j
  return (AeTax.country.computeWith args c, c)

def parses (s : String) : Bool := match Json.parse s >>= parseCanon with | .ok _ => true | .error _ => false

/-- A figure of the output: net, incomeTax, tax (income tax + surtaxes + local), social, benefits or a detail key. -/
def fig (args : List String) (field : String) (s : String) : Int :=
  match outOf args s with
  | .error _ => -999999999999
  | .ok (o, c) =>
    if field == "net" then o.net c.gross
    else if field == "incomeTax" then o.incomeTax
    else if field == "tax" then o.incomeTax + o.surtaxes.foldl (fun a p => a + p.2) 0 + o.localIncomeTax
    else if field == "social" then o.employeeSocial
    else if field == "benefits" then o.benefits
    else match o.detail.lookup field with
      | some j => (j.getInt?).toOption.getD (-999999999998)
      | none => -999999999997

-- F1 f1_iloe_doubling: FDL 13/2022 art. 4: ILOE premium 5 -> 10 a month above a basic salary of 16,000
#guard parses "{\"id\":\"a\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":192000,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":0,\"charitable\":0,\"pensionContributions\":0}" && parses "{\"id\":\"b\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":192012,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":0,\"charitable\":0,\"pensionContributions\":0}" && fig [] "social" "{\"id\":\"b\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":192012,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":0,\"charitable\":0,\"pensionContributions\":0}" - fig [] "social" "{\"id\":\"a\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":192000,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":0,\"charitable\":0,\"pensionContributions\":0}" == 61

