import AeTax.Legacy
import TaxKernel.Global
import AeGlobal.Consumption
import AeGlobal.Corporate
import AeGlobal.Social
import AeGlobal.Payroll
import AeGlobal.Property
import AeGlobal.Transfers
import AeGlobal.Other

/-! # United Arab Emirates: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace AeGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ socialUnsupported g ++ payrollUnsupported g ++ propertyUnsupported g ++ transfersUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry AeTax.country) with
    families := [consumption, corporate, social, payroll, property, transfers], unsupported := unsupported, absent := otherAbsent,
    notes := ["United Arab Emirates 2025, kernel 2.0 (cmp20/global/R5/ae); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (AeTax.country.computeWith args c).toJson :=
  conservative_pit model AeTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end AeGlobal
