def customs : Family := customsFamily [tariff] "5123 customs import duty (WTO IDB 2025)"

/-- Imported lines whose duty the tariff cannot settle (kernel `TariffRule.unknown`: grade C). -/
def customsUnsupported (g : CanonGlobal) : List String := tariff.unknown g

def custT (s : String) : CanonGlobal :=
  match Json.parse s with
  | .ok j => (match parseGlobal j with | .ok g => g | .error _ => default)
  | .error _ => default

-- tobaccoOther (hs 2403191000) from CN (no preference): customs value 12345, MFN 12 % = 12345 x 1200 / 10000 = 1481
#guard (tariff.charges (custT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"consumption\":[{\"good\":\"tobaccoOther\",\"amount\":24690,\"hs\":\"2403191000\",\"origin\":\"CN\",\"customsValue\":12345}]}")).map (·.due) == [1481]
-- food (hs 090121) from CN: MFN 0 % (a charge of 0)
#guard (tariff.charges (custT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"consumption\":[{\"good\":\"food\",\"amount\":24690,\"hs\":\"090121\",\"origin\":\"CN\",\"customsValue\":12345}]}")).map (·.due) == [0]
