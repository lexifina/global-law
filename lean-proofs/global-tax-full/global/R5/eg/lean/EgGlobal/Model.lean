/-! # Egypt: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace EgGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ socialUnsupported g ++ payrollUnsupported g ++ propertyUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry EgTax.country) with
    families := [consumption, corporate, social, property], unsupported := unsupported, absent := otherAbsent,
    notes := ["Egypt 2025, kernel 2.0 (cmp20/global/R5/eg); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (EgTax.country.computeWith args c).toJson :=
  conservative_pit model EgTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end EgGlobal
