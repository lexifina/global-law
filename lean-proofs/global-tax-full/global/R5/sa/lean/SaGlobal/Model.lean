/-! # Saudi Arabia: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace SaGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ socialUnsupported g ++ payrollUnsupported g ++ propertyUnsupported g ++ transfersUnsupported g ++ zakatUnsupported g ++ customsUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry SaTax.country) with
    families := [consumption, corporate, social, property, transfers, zakat, customs], unsupported := unsupported, absent := otherAbsent,
    notes := ["Saudi Arabia 2025, kernel 2.0 (cmp20/global/R5/sa); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SaTax.country.computeWith args c).toJson :=
  conservative_pit model SaTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SaGlobal
