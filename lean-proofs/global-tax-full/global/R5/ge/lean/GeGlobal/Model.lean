/-! # Georgia: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace GeGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ capitalUnsupported g ++ propertyUnsupported g ++ wealthUnsupported g ++ vehiclesUnsupported g ++ customsUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry GeTax.country) with
    families := [consumption, corporate, capital, social, property, wealth, vehicles, customs], unsupported := unsupported, absent := otherAbsent,
    notes := ["Georgia 2025, kernel 2.0 (cmp20/global/R5/ge); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (GeTax.country.computeWith args c).toJson :=
  conservative_pit model GeTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end GeGlobal
