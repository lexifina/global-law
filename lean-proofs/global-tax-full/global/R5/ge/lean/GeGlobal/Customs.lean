#guard (tariff.charges (custT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"consumption\":[{\"good\":\"beer\",\"amount\":24690,\"hs\":\"220300\",\"origin\":\"JP\",\"customsValue\":12345}]}")).map (·.due) == [1481]
-- food (hs 170199) from AT: EU - Georgia free trade agreement; United Kingdom - Georgia free trade agreement 0 % instead of MFN 12 %: 12345 x 0 / 10000 = 0
