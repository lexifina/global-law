def customs : Family := customsFamily [tariff] "5123 customs import duty (WTO IDB 2025)"

/-- Imported lines whose duty the tariff cannot settle (kernel `TariffRule.unknown`: grade C). -/
def customsUnsupported (g : CanonGlobal) : List String := tariff.unknown g

def custT (s : String) : CanonGlobal :=
  match Json.parse s with
  | .ok j => (match parseGlobal j with | .ok g => g | .error _ => default)
  | .error _ => default

