import CYTax.Legacy
import TaxKernel.Global
import CyGlobal.Consumption
import CyGlobal.Corporate
import CyGlobal.Capital
import CyGlobal.Social
import CyGlobal.Transfers
import CyGlobal.Other

/-! # Cyprus: kernel-2.0 model (generated by R5/tools/gen_model.py). The 1.x `cytax` prints euros with cents
(`outJson`), so the PIT is wrapped by the exe's own line function (`GlobalModel.ofLine`, DESIGN §4). -/

namespace CyGlobal
open TaxKernel TaxKernel.Global Lean

def pitLine (args : List String) (j : Json) : Json :=
  match parseCanon j with
  | .ok c => _root_.outJson (CYTax.country.computeWith args c)
  | .error e => Json.mkObj [("id", Json.str ((j.getObjValAs? String "id").toOption.getD "")), ("error", Json.str e)]

def pitOf (args : List String) (c : Canon) : Int := jsonIncomeTax (pitLine args c.raw)

def base : GlobalModel := GlobalModel.ofLine "CY" "Cyprus" "EUR" "2025" pitLine

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ capitalUnsupported g ++ socialUnsupported g ++ transfersUnsupported g

def model : GlobalModel :=
  { base with
    families := [consumption, corporate, capital, social, transfers], unsupported := unsupported, absent := otherAbsent,
    notes := ["Cyprus 2025, kernel 2.0 (cmp20/global/R5/cy); statutes cited per charge"] }

theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = pitLine args c.raw := rfl

end CyGlobal
