import MaTax.Legacy
import TaxKernel.Global
import MaGlobal.Consumption
import MaGlobal.Corporate
import MaGlobal.Capital
import MaGlobal.Social
import MaGlobal.Transfers
import MaGlobal.Wealth
import MaGlobal.Vehicles
import MaGlobal.Other

/-! # Morocco: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace MaGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ capitalUnsupported g ++ socialUnsupported g ++ transfersUnsupported g ++ wealthUnsupported g ++ vehiclesUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry MaTax.country) with
    families := [consumption, corporate, capital, social, transfers, wealth, vehicles], unsupported := unsupported, absent := otherAbsent,
    notes := ["Morocco 2025, kernel 2.0 (cmp20/global/R5/ma); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (MaTax.country.computeWith args c).toJson :=
  conservative_pit model MaTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end MaGlobal
