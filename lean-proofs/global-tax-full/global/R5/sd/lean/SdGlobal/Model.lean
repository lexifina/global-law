import SdGlobal.Other

/-! # Sudan: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace SdGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := consumptionUnsupported g ++ corporateUnsupported g ++ payrollUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry SdTax.country) with
    families := [corporate], unsupported := unsupported, absent := otherAbsent,
    notes := ["Sudan 2025, kernel 2.0 (cmp20/global/R5/sd); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SdTax.country.computeWith args c).toJson :=
  conservative_pit model SdTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SdGlobal
