import SyTax.Legacy
import TaxKernel.Global
import SyGlobal.Corporate
import SyGlobal.Social
import SyGlobal.Payroll
import SyGlobal.Other

/-! # Syria: kernel-2.0 model (generated by R5/tools/gen_model.py from the family modules; DESIGN.md §6) -/

namespace SyGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String := corporateUnsupported g ++ socialUnsupported g ++ payrollUnsupported g

def model : GlobalModel :=
  { (GlobalModel.ofCountry SyTax.country) with
    families := [corporate], unsupported := unsupported, absent := otherAbsent,
    notes := ["Syria 2025, kernel 2.0 (cmp20/global/R5/sy); statutes cited per charge"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SyTax.country.computeWith args c).toJson :=
  conservative_pit model SyTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SyGlobal
