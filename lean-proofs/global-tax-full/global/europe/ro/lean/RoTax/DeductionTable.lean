import TaxKernel

/-! # Codul fiscal art. 77 alin. (4): the table of the deducere personală de bază, transcribed row by row

Generated by `harness/gen_table.py` from `law/art-077_2025-06-30.txt` (Global law, art. 77 as in force on 2025-06-30;
official text https://legislatie.just.ro/Public/DetaliiDocument/262796, wording of OG nr. 16/2022, in force 2023-01-01).
Each row: gross monthly wage from `salariul minim + lo` to `salariul minim + hi` lei; the five values are the
percentages of the minimum wage, in basis points, for 0, 1, 2, 3 and "4 și peste" dependants. The first row of the
statute ("1 ... salariul minim") is `firstRow`. The statute prints two cells with a dot ("12.00%", "7.00%"): read as
12,00 % and 7,00 %. -/

namespace RoTax
open TaxKernel

/-- art. 77 alin. (4), row "1 / salariul minim": 20.00 %, 25.00 %, 30.00 %, 35.00 %, 45.00 % -/
def firstRow : List Int := [2000, 2500, 3000, 3500, 4500]

/-- art. 77 alin. (4), the 40 rows above the minimum wage: (lo, hi, [bp for 0..4+ dependants]); lo/hi are lei above the minimum wage. -/
def stepRows : List (Int × Int × List Int) := [
