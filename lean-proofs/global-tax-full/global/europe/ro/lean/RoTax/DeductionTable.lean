/-- The column for `n` dependants (n ≥ 4 is "4 și peste") as a kernel `Table` keyed by lei above the minimum wage. -/
def stepTable (n : Nat) : Table := stepRows.map fun (lo, hi, vs) => ⟨lo, hi, vs.getD (min n 4) 0⟩

