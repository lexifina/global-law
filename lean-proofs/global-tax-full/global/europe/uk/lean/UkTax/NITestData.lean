theorem rows_count : rows.length = 448 := by decide

/-- **All 448 rows** of HMRC's test data are reproduced by `class1Period` with the test data's rounding. -/
theorem hmrc_ni_test_data :
    rows.all (fun r => decide (class1Period p2025 roundTestData r.freq r.cat r.pay = r.employee)) = true := by
  decide

/-- With CWG2's rule ("to the nearest penny, rounding down exact amounts of £0.005") 401 of the 448 rows agree. -/
theorem cwg2_rule_rows :
    (rows.filter (fun r => decide (class1Period p2025 roundCWG2 r.freq r.cat r.pay = r.employee))).length = 401 := by
  decide

/-- The first row where guide and data part: weekly pay £242.07, category A: 7p above the threshold at 8 % is
0.56p; the test data say nil, CWG2's rule a penny. -/
theorem cwg2_vs_test_data :
    class1Period p2025 roundTestData .weekly 'A' 24207 = 0 ∧ class1Period p2025 roundCWG2 .weekly 'A' 24207 = 1 := by
  decide

/-- HMRC's directors' NIC test data v1.0, sheet "3_Dir_CatA_£52000_pa" (annual earnings period): a director earning
£52,000 pays £3,050.60 — the annual figure the household model uses. -/
theorem director_annual_52000 : class1Period p2025 roundTestData .annual 'A' 5200000 = 305060 := by decide

