def exactRows (s : Sheet) : Nat :=
  ((payeRun s.per s.payments).zip s.expected |>.filter fun (a, b) => a == b).length

def within1p (s : Sheet) : Bool :=
  ((payeRun s.per s.payments).zip s.expected).all fun (a, b) =>
    decide ((a.1 - b.1).natAbs ≤ 1) && decide ((a.2 - b.2).natAbs ≤ 1)

theorem sheet_count : sheets.length = 22 ∧ (sheets.map (·.payments.length)).foldl (· + ·) 0 = 168 := by decide

/-- **Every one of the 168 payments is within HMRC's tolerance of a penny**, and **159 are exact**: all of the rest of
the UK and Wales (cumulative, Week 1/Month 1, BR, D0, D1, NT, K and large codes) and the Scottish weekly sheets. The 9
others are Scottish monthly payments, a penny off. -/
theorem hmrc_paye_test_data :
    sheets.all within1p = true ∧ (sheets.map exactRows).foldl (· + ·) 0 = 159 := by
  decide

