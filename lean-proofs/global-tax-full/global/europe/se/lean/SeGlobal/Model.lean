import SeGlobal.Pit
import SeGlobal.Consumption
import SeGlobal.Corporate
import SeGlobal.Capital
import SeGlobal.Social
import SeGlobal.Property
import SeGlobal.Wealth
import SeGlobal.Other

/-! # Sweden: kernel-2.0 model (generated by europe/tools/gen_model.py from the family files present:
Consumption, Corporate, Capital, Social, Property, Wealth, Other) -/

namespace SeGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := base.families ++ Consumption.families ++ Corporate.families ++ Capital.families ++ Social.families ++ Property.families ++ Wealth.families ++ Other.families,
    absent := base.absent ++ Consumption.absent ++ Corporate.absent ++ Capital.absent ++ Social.absent ++ Property.absent ++ Wealth.absent ++ Other.absent,
    notes := base.notes ++ Consumption.notes ++ Corporate.notes ++ Capital.notes ++ Social.notes ++ Property.notes ++ Wealth.notes ++ Other.notes,
    unsupported := fun args g => base.unsupported args g ++ Consumption.unsupported args g ++ Corporate.unsupported args g ++ Capital.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Wealth.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged: the PIT is the 1.x exe's own line function on the household's input line. -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = pitLine args c.raw := rfl

end SeGlobal
