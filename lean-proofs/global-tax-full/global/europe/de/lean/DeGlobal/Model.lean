import DeGlobal.Pit
import DeGlobal.Consumption
import DeGlobal.Corporate
import DeGlobal.Social
import DeGlobal.Property
import DeGlobal.Wealth
import DeGlobal.Other

/-! # Germany: kernel-2.0 model (generated by europe/tools/gen_model.py from the family files present:
Consumption, Corporate, Social, Property, Wealth, Other) -/

namespace DeGlobal
open TaxKernel TaxKernel.Global

def fullModel : GlobalModel :=
  { base with
    families := base.families ++ Consumption.families ++ Corporate.families ++ Social.families ++ Property.families ++ Wealth.families ++ Other.families,
    absent := base.absent ++ Consumption.absent ++ Corporate.absent ++ Social.absent ++ Property.absent ++ Wealth.absent ++ Other.absent,
    notes := base.notes ++ Consumption.notes ++ Corporate.notes ++ Social.notes ++ Property.notes ++ Wealth.notes ++ Other.notes,
    unsupported := fun args g => (base.unsupported args g).filter (fun s => !(s.startsWith "alcohol and tobacco duties")) ++ Consumption.unsupported args g ++ Corporate.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Wealth.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged: the pilot's PIT, i.e. the 1.x `detax` line function (`DeGlobal.model_pit`). -/
theorem fullModel_pit (args : List String) (c : Canon) :
    (fullModel.computeGlobal args (CanonGlobal.ofCanon c)).pit = _root_.runHousehold (deOpts args) c.raw := rfl

end DeGlobal
