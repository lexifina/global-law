import FrGlobal.Pit
import FrGlobal.Consumption
import FrGlobal.Corporate
import FrGlobal.Capital
import FrGlobal.Social
import FrGlobal.Property
import FrGlobal.Transfers
import FrGlobal.Wealth
import FrGlobal.Other

/-! # France: kernel-2.0 model (generated by europe/tools/gen_model.py from the family files present:
Consumption, Corporate, Capital, Social, Property, Transfers, Wealth, Other) -/

namespace FrGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := base.families ++ Consumption.families ++ Corporate.families ++ Capital.families ++ Social.families ++ Property.families ++ Transfers.families ++ Wealth.families ++ Other.families,
    absent := base.absent ++ Consumption.absent ++ Corporate.absent ++ Capital.absent ++ Social.absent ++ Property.absent ++ Transfers.absent ++ Wealth.absent ++ Other.absent,
    notes := base.notes ++ Consumption.notes ++ Corporate.notes ++ Capital.notes ++ Social.notes ++ Property.notes ++ Transfers.notes ++ Wealth.notes ++ Other.notes,
    unsupported := fun args g => base.unsupported args g ++ Consumption.unsupported args g ++ Corporate.unsupported args g ++ Capital.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Transfers.unsupported args g ++ Wealth.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged: the PIT is the 1.x exe's own line function on the household's input line. -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = pitLine args c.raw := rfl

end FrGlobal
