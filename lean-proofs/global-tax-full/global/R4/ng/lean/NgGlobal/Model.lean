import NgTax.Legacy
import NgGlobal.Consumption
import NgGlobal.Corporate
import NgGlobal.Other
import NgGlobal.Social
import NgGlobal.Capital
import NgGlobal.Customs

/-! # NG: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace NgGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g ++ capitalNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry NgTax.country) with
    families := [vat, corporate, stampConveyance, tet, itf, nsitf, divWht], unsupported,
    notes := ["Nigeria 2025 (R4): -"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (NgTax.country.computeWith args c).toJson :=
  conservative_pit model NgTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end NgGlobal
