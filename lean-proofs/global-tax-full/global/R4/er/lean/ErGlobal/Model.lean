import ErTax.Legacy
import ErGlobal.Consumption
import ErGlobal.Corporate
import ErGlobal.Social

/-! # ER: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace ErGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry ErTax.country) with
    families := [], unsupported,
    notes := ["Eritrea 2025 (R4): -"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (ErTax.country.computeWith args c).toJson :=
  conservative_pit model ErTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end ErGlobal
