import GqTax.Legacy
import GqGlobal.Consumption
import GqGlobal.Corporate
import GqGlobal.Property
import GqGlobal.Transfers
import GqGlobal.Social

/-! # GQ: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace GqGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ propertyNotes g ++ transfersNotes g ++ socialNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry GqTax.country) with
    families := [vat, excise, corporate, itp, ibi, patrimonio, inseso], unsupported,
    notes := ["Equatorial Guinea 2025 (R4): Ley Tributaria Núm. 1/2024 (in force for 2025)"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (GqTax.country.computeWith args c).toJson :=
  conservative_pit model GqTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end GqGlobal
