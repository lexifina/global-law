import CgTax.Legacy
import CgGlobal.Consumption
import CgGlobal.Corporate
import CgGlobal.Other
import CgGlobal.Social

/-! # CG: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace CgGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry CgTax.country) with
    families := [vat, excise, corporate, tvts, cnssPfAt, camu, cnssPension, fncAcpe], unsupported,
    notes := ["Congo 2025 (R4): Loi n° 47-2024 du 30 décembre 2024 portant loi de finances pour l'année 2025 (JO édition spéciale n° 15-2024 du 31 décembre 2024) and the VAT text as rewritten by Loi n° 39-2023 du 29 décembre 2023 (LF 2024, JO édition spéciale n° 6-2023); CGI tome 1 (edition date not established) for the withholding"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (CgTax.country.computeWith args c).toJson :=
  conservative_pit model CgTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end CgGlobal
