import SoTax.Legacy
import SoGlobal.Consumption
import SoGlobal.Corporate
import SoGlobal.Social

/-! # SO: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace SoGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry SoTax.country) with
    families := [corporate], unsupported,
    notes := ["Somalia 2025 (R4): Income Tax Law (Sharciga Canshuurta Dakhliga), Law No. 37 of 11 May 2025, in force on the President's signature (art. 106); the previous law applies only to tax years ending before that date (art. 105 (3) (b)), so the 2025 tax year falls under Law 37"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SoTax.country.computeWith args c).toJson :=
  conservative_pit model SoTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SoGlobal
