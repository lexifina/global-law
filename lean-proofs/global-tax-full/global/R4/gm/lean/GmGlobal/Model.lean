import GmTax.Legacy
import GmGlobal.Consumption
import GmGlobal.Corporate
import GmGlobal.Other
import GmGlobal.Social
import GmGlobal.Customs

/-! # GM: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace GmGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry GmTax.country) with
    families := [vat, corporate, stampConveyance, sshfc], unsupported,
    notes := ["Gambia 2025 (R4): GRA guides (official secondary): VAT leaflet; 'Corporation Income Tax', 'Withholding Tax' and 'Dividend Income Tax' brochures (published on gra.gm 21 Aug 2023; the corporation-tax brochure dates its rate to 2018); Income and Value Added Tax Act 2012 and later Finance Acts not held: grade B"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (GmTax.country.computeWith args c).toJson :=
  conservative_pit model GmTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end GmGlobal
