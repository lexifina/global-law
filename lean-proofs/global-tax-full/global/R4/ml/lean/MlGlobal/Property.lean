import R4Common

/-! # ML 2025: Property (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/ml.json)

Taxe foncière (3 % of annual rental value; owner-occupied home exempt) (CGI art. 185-E to 185-L (loi n° 2011-035; consolidation 2017, flagged)): art. 185-H: base = annual rental value; art. 185-L: rate 3 %; art. 185-G 10°: buildings not let and occupied by the owner or dependent family members are exempt — the household's home is exempt, other buildings are taxed on their annual value.

Droit d'enregistrement sur les mutations d'immeubles à titre onéreux (15 %) (CGI art. 269-270 (loi n° 10-014; consolidation 2017, flagged)): art. 269: base = price plus charges or an expert estimate; art. 270 (the only tariff of 'Mutations à titre onéreux — Les immeubles — B. Tarifs'): 15 %, reduced to 7 % for housing without a land title and for business acquisitions entered in the balance sheet. -/

namespace MlGlobal
open TaxKernel TaxKernel.Global

def tf : Family :=
  R4.propertyAnnualFamily "Taxe foncière (3 % of annual rental value; owner-occupied home exempt)" 300 [.realEstate] "CGI art. 185-E to 185-L (loi n° 2011-035; consolidation 2017, flagged)"

def tfT : CanonGlobal := { id := "h", household := { id := "h" }, assets := [{ kind := .realEstate, value := 0, annualValue := 1000000 }, { kind := .realEstate, value := 0, annualValue := 10000 }, { kind := .vehicle, value := 1000000 }] }
#guard ((tf.run [] tfT []).map (·.due)) == [30000, 300]

def mutImm : Family :=
  R4.transferDutyFamily "Droit d'enregistrement sur les mutations d'immeubles à titre onéreux (15 %)" 1500 [.home, .realEstate, .land] "CGI art. 269-270 (loi n° 10-014; consolidation 2017, flagged)"

def mutImmT : CanonGlobal := { id := "h", household := { id := "h" }, purchases := [{ kind := .home, price := 1000000 }] }
#guard ((mutImm.run [] mutImmT []).map (·.due)) == [150000]

def propertyNotes (g : CanonGlobal) : List String :=
  []

end MlGlobal
