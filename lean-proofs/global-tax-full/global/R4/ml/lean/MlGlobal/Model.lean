import MlTax.Legacy
import MlGlobal.Consumption
import MlGlobal.Corporate
import MlGlobal.Other
import MlGlobal.Transfers
import MlGlobal.Capital
import MlGlobal.Social
import MlGlobal.Property
import MlGlobal.Absent
import MlGlobal.Customs

/-! # ML: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace MlGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ transfersNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry MlTax.country) with
    families := [vat, corporate, patente, tva, irvmDiv, irvmInt, irf, tpvShares, cfe, tfp, tej, inps, tf, mutImm], unsupported, absent := absentList,
    notes := ["Mali 2025 (R4): Code général des impôts, DGI consolidation 'CGI_VF_MaJ_20170802' (published at www.dgi.gouv.ml/CGI/, updated to the LF 2017 / LFR 2017); no later finance law held — flagged"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (MlTax.country.computeWith args c).toJson :=
  conservative_pit model MlTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end MlGlobal
