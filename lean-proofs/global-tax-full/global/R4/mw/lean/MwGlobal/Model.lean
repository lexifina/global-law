import MwTax.Legacy
import MwGlobal.Consumption
import MwGlobal.Corporate
import MwGlobal.Other
import MwGlobal.Absent
import MwGlobal.Customs

/-! # MW: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace MwGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry MwTax.country) with
    families := [vat, excise, exciseUsd, corporate, stampConveyance], unsupported, absent := absentList,
    notes := ["Malawi 2025 (R4): Taxation Act Cap. 41:01 Eleventh Schedule as replaced by Act No. 14 of 2020 and amended by Act No. 12 of 2024 (published 19 Apr 2024); Value Added Tax Act Cap. 42:02 s. 9 as read in Act No. 37 of 2025 (16.5 % until 29 Dec 2025, 17.5 % from publication on 30 Dec 2025); Customs and Excise (Tariffs) Order 2022 as updated by MRA for 2024-2025"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (MwTax.country.computeWith args c).toJson :=
  conservative_pit model MwTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end MwGlobal
