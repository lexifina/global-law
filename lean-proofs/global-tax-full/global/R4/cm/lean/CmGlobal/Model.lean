import CmTax.Legacy
import CmGlobal.Consumption
import CmGlobal.Corporate
import CmGlobal.Transfers
import CmGlobal.Other
import CmGlobal.Capital
import CmGlobal.Social
import CmGlobal.Property
import CmGlobal.Absent

/-! # CM: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace CmGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ transfersNotes g ++ otherNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry CmTax.country) with
    families := [vat, excise, corporate, succession, donation, timbreGradue, patente, timbreAuto, ircmDiv, ircmInt, cfcFne, cnpsPf, cnpsPvid, cnpsAt, mutBati, mutNonBati, foncier], unsupported, absent := absentList,
    notes := ["Cameroon 2025 (R4): CGI edition 2024 + LF 2025 circular"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (CmTax.country.computeWith args c).toJson :=
  conservative_pit model CmTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end CmGlobal
