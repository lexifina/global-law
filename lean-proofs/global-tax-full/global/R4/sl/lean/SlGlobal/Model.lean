import SlTax.Legacy
import SlGlobal.Consumption
import SlGlobal.Corporate
import SlGlobal.Other
import SlGlobal.Capital
import SlGlobal.Social
import SlGlobal.Customs

/-! # SL: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace SlGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ capitalNotes g ++ socialNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry SlTax.country) with
    families := [vat, excise, corporate, stampConveyance, divWht, intWht, nassit], unsupported,
    notes := ["Sierra Leone 2025 (R4): Income Tax Act 2000 as amended to the Finance Act 2017, with the Finance Acts 2018-2025 (FA 2025 in force 1 Jan 2025) read for the provisions modelled; FA 2026 changes (from 2026) not applied"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SlTax.country.computeWith args c).toJson :=
  conservative_pit model SlTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SlGlobal
