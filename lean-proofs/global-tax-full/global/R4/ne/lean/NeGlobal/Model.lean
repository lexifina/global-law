import NeTax.Legacy
import NeGlobal.Consumption
import NeGlobal.Corporate
import NeGlobal.Property
import NeGlobal.Capital
import NeGlobal.Transfers
import NeGlobal.Other
import NeGlobal.Social
import NeGlobal.Absent
import NeGlobal.Customs

/-! # NE: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace NeGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ propertyNotes g ++ capitalNotes g ++ transfersNotes g ++ otherNotes g ++ socialNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry NeTax.country) with
    families := [vat, excise, corporate, regImm, irbh, irvmDiv, ircInt, pvTitres, pvImm, mutGratuit, taxePro, vignette, ta, cnss], unsupported, absent := absentList,
    notes := ["Niger 2025 (R4): CGI MAJ LF 2022 + LF 2025"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (NeTax.country.computeWith args c).toJson :=
  conservative_pit model NeTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end NeGlobal
