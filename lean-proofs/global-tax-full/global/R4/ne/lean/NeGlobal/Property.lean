import R4Common

/-! # NE 2025: Property (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/ne.json)

Droit de mutation immobilière à titre onéreux (CGI art. 466 (3 %)): art. 466: "Les adjudications, ventes, reventes, rétrocessions ... et tous autres actes civils et judiciaires translatifs de propriété ou d'usufruit de biens immeubles à titre onéreux sont assujettis à un droit de 3%." The LF 2025 (art. 30) amends art. 377 and 481 and repeals art. 469 and 482 only; LF 2023 and LF 2024 are not held: grade B.

Impôt sur les revenus des baux d'habitation (12 % of annual rental value; main residence exempt) (CGI Livre I art. 146-148, 159 as amended by Ordonnance n° 2024-59 (LF 2025) art. 16): art. 147: base = rental value of buildings let as dwellings; art. 148 (new): 12 % of the annual rental value, 6 % for free and secondary dwellings; art. 159 6° (new): the main residence is exempt. The household's other buildings are taken as let dwellings. -/

namespace NeGlobal
open TaxKernel TaxKernel.Global

def regImm : Family :=
  R4.transferDutyFamily "Droit de mutation immobilière à titre onéreux" 300 [.home, .realEstate, .land] "CGI art. 466 (3 %)"

def regImmT : CanonGlobal := { id := "h", household := { id := "h" }, purchases := [{ kind := .home, price := 1000000 }] }
#guard ((regImm.run [] regImmT []).map (·.due)) == [30000]

def irbh : Family :=
  R4.propertyAnnualFamily "Impôt sur les revenus des baux d'habitation (12 % of annual rental value; main residence exempt)" 1200 [.realEstate] "CGI Livre I art. 146-148, 159 as amended by Ordonnance n° 2024-59 (LF 2025) art. 16"

def irbhT : CanonGlobal := { id := "h", household := { id := "h" }, assets := [{ kind := .realEstate, value := 0, annualValue := 1000000 }, { kind := .realEstate, value := 0, annualValue := 10000 }, { kind := .vehicle, value := 1000000 }] }
#guard ((irbh.run [] irbhT []).map (·.due)) == [120000, 1200]

def propertyNotes (g : CanonGlobal) : List String :=
  (if !(g.assets.isEmpty && g.purchases.isEmpty) then ["CGI art. 466: 3 % (edition updated to LF 2022; LF 2023-2024 not held)"] else [])

end NeGlobal
