import NaTax.Legacy
import NaGlobal.Consumption
import NaGlobal.Corporate
import NaGlobal.Other
import NaGlobal.Social
import NaGlobal.Property
import NaGlobal.Customs

/-! # NA: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace NaGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry NaTax.country) with
    families := [vat, excise, corporate, stampTransferNat, stampTransferCo, msd, vetLevy, vetLevyHh, transferDutyNat, transferDutyCo], unsupported,
    notes := ["Namibia 2025 (R4): Income Tax Act 1981 as in force from 2024-09-16 (Act 4 of 2024), NamibLII archived 2026-02-12"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (NaTax.country.computeWith args c).toJson :=
  conservative_pit model NaTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end NaGlobal
