import NaTax.Basic

/-! L1 loophole round (Africa / Middle East, 2026-11-20): the #guards behind FINDINGS.md "Verification".
Each guard runs `NaTax.country` on a contract household (the JSON line the exe reads) and checks a figure or the
difference between two households. Generated by world/loopholes/africa_mena/vgen.py from checks/NA.json. -/

namespace NaTax.Verify
open TaxKernel Lean

def outOf (args : List String) (s : String) : Except String (Out × Canon) := do
  let j ← Json.parse s
  let c ← parseCanon j
  return (NaTax.country.computeWith args c, c)

def parses (s : String) : Bool := match Json.parse s >>= parseCanon with | .ok _ => true | .error _ => false

/-- A figure of the output: net, incomeTax, tax (income tax + surtaxes + local), social, benefits or a detail key. -/
def fig (args : List String) (field : String) (s : String) : Int :=
  match outOf args s with
  | .error _ => -999999999999
  | .ok (o, c) =>
    if field == "net" then o.net c.gross
    else if field == "incomeTax" then o.incomeTax
    else if field == "tax" then o.incomeTax + o.surtaxes.foldl (fun a p => a + p.2) 0 + o.localIncomeTax
    else if field == "social" then o.employeeSocial
    else if field == "benefits" then o.benefits
    else match o.detail.lookup field with
      | some j => (j.getInt?).toOption.getD (-999999999998)
      | none => -999999999997

-- F1 f1_interest_final_10pct: ITA s. 34A: final 10 % on bank interest
#guard parses "{\"id\":\"a\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":1700000,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":0,\"charitable\":0,\"pensionContributions\":0}" && parses "{\"id\":\"b\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":1600000,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":100000,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":0,\"charitable\":0,\"pensionContributions\":0}" && fig [] "net" "{\"id\":\"b\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":1600000,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":100000,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":0,\"charitable\":0,\"pensionContributions\":0}" - fig [] "net" "{\"id\":\"a\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":1700000,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":0,\"charitable\":0,\"pensionContributions\":0}" == 27000

