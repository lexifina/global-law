import DjTax.Legacy
import DjGlobal.Consumption
import DjGlobal.Corporate
import DjGlobal.Social
import DjGlobal.Property
import DjGlobal.Absent

/-! # DJ: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace DjGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry DjTax.country) with
    families := [vat, corporate, cnss, cfpb, mutImm], unsupported, absent := absentList,
    notes := ["Djibouti 2025 (R4): Finance laws 2017-2025 (Loi n°203/AN/25 for 2025); the CGI itself not held"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (DjTax.country.computeWith args c).toJson :=
  conservative_pit model DjTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end DjGlobal
