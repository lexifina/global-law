import BiTax.Legacy
import BiGlobal.Consumption
import BiGlobal.Corporate
import BiGlobal.Capital
import BiGlobal.Social
import BiGlobal.Customs

/-! # BI: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace BiGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ capitalNotes g ++ socialNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry BiTax.country) with
    families := [vat, excise, corporate, divWht, intWht, gains, inssPension, inssRisks], unsupported,
    notes := ["Burundi 2025 (R4): Loi n°1/14 du 24 décembre 2020 (impôts sur les revenus) and Loi n°1/10 du 16 novembre 2020 (TVA) with the LF 2025/2026 derogations (budget year July 2025 - June 2026); LF 2021/22-2024/25 not held"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (BiTax.country.computeWith args c).toJson :=
  conservative_pit model BiTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end BiGlobal
