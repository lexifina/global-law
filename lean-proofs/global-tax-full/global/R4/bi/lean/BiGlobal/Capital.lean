def gains : Family :=
  R4.gainsFamily "Impôt sur les plus-values" 1500 [.realEstate, .land, .listedShares, .unlistedShares, .home] "Loi IR 2020 art. 23 (15 %) [text version: Loi n°1/14 du 24 décembre 2020 as promulgated (obr.bi scan, Wayback; world/B08-central-africa-fr/bi/law/loi_ir_2020.pdf); the LF 2025/2026 derogations read (art. 137-149) do not touch art. 23; LF 2021/22-2023/24 and the tax articles of the revised LF 2024/25 not read (flag)]"

def gainsT : CanonGlobal := { id := "h", household := { id := "h" }, disposals := [{ kind := .realEstate, proceeds := 5000000, cost := 3000000 }] }
#guard ((gains.run [] gainsT []).map (·.due)) == [300000]

def capitalNotes (g : CanonGlobal) : List String :=
  (if !(g.incomes.isEmpty && g.disposals.isEmpty) then ["Loi IR 2020 art. 23: gains taxed at 15 % (gain = proceeds - cost - costs; the computation and exemption articles not read)"] else [])

