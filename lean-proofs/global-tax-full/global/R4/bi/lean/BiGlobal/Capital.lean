namespace BiGlobal
open TaxKernel TaxKernel.Global

def divWht : Family :=
  R4.finalWhtFamily .dividend "Impôt sur les revenus du capital (dividendes)" 1500 "Loi IR 2020 art. 23 (15 %), art. 122 1° (retenue 15 %) [text version: Loi n°1/14 du 24 décembre 2020 as promulgated (obr.bi scan, Wayback; world/B08-central-africa-fr/bi/law/loi_ir_2020.pdf); art. 122 restated with the same 15 % by LF 2025/2026 art. 139 (from 1 July 2025); LF 2021/22-2023/24 and the tax articles of the revised LF 2024/25 not read (flag)]"

def divWhtT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .dividend, amount := 1000000 }] }
