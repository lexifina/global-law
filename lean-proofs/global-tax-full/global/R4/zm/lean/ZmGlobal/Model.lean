import ZmTax.Legacy
import ZmGlobal.Consumption
import ZmGlobal.Corporate
import ZmGlobal.Other
import ZmGlobal.Social
import ZmGlobal.Property
import ZmGlobal.Capital
import ZmGlobal.Absent
import ZmGlobal.Customs

/-! # ZM: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace ZmGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g ++ propertyNotes g ++ capitalNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry ZmTax.country) with
    families := [vat, excise, corporate, roadTax, napsa, sdl, nhima, ptt, divWht], unsupported, absent := absentList,
    notes := ["Zambia 2025 (R4): ZRA tax information pages (official secondary: live 2026-11-21 and Wayback 2025-05-16); Income Tax (Amendment) Acts 2023-2025 held"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (ZmTax.country.computeWith args c).toJson :=
  conservative_pit model ZmTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end ZmGlobal
