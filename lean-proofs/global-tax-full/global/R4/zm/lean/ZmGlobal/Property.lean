def pttT : CanonGlobal := { id := "h", household := { id := "h" }, disposals := [{ kind := .home, proceeds := 1000000, cost := 0 }, { kind := .home, proceeds := 250000000, cost := 0 }], purchases := [{ kind := .home, price := 1000000 }] }
