import LrTax.Legacy
import LrGlobal.Consumption
import LrGlobal.Corporate
import LrGlobal.Social
import LrGlobal.Absent
import LrGlobal.Customs

/-! # LR: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace LrGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry LrTax.country) with
    families := [vat, exciseUsd, corporate, nasscorp], unsupported, absent := absentList,
    notes := ["Liberia 2025 (R4): Liberia Revenue Code (amended 2020) and Tax Amendment Act of December 2024 (approved 17 Dec 2024, in force on publication 20 Dec 2024)"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (LrTax.country.computeWith args c).toJson :=
  conservative_pit model LrTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end LrGlobal
