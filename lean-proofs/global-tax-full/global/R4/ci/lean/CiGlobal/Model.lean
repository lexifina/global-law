import CiTax.Legacy
import CiGlobal.Consumption
import CiGlobal.Corporate
import CiGlobal.Other
import CiGlobal.Social
import CiGlobal.Property
import CiGlobal.Capital
import CiGlobal.Transfers
import CiGlobal.Absent

/-! # CI: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace CiGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g ++ propertyNotes g ++ capitalNotes g ++ transfersNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry CiTax.country) with
    families := [vat, excise, corporate, vignette, contribEmployeur, cnpsRetraite, cnpsPfAt, ipfLet, ipfHome, ipfLand, mutImm, irvmDiv, ircInt, mutGratuit], unsupported, absent := absentList,
    notes := ["Côte d'Ivoire 2025 (R4): Code général des Impôts 2025 (DGI online edition at cgici.com/V2025, the CGI link of dgi.gouv.ci; includes the annexe fiscale 2025, loi n° 2024-1109 du 18 déc. 2024)"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (CiTax.country.computeWith args c).toJson :=
  conservative_pit model CiTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end CiGlobal
