import AoTax.Legacy
import AoGlobal.Consumption
import AoGlobal.Corporate
import AoGlobal.Other
import AoGlobal.Social
import AoGlobal.Property
import AoGlobal.Capital
import AoGlobal.Customs

/-! # AO: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace AoGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g ++ propertyNotes g ++ capitalNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry AoTax.country) with
    families := [vat, excise, corporate, seloImoveis, inss, ipRenda, ipTransmissao, ipDetencao, iacDiv, iacInt, iacGains], unsupported,
    notes := ["Angola 2025 (R4): Código do IVA as republished by Lei n.º 14/23 de 28 de Dezembro (in force on publication), Lei n.º 16/21 de 19 de Julho (Imposto Especial de Consumo), Código do Imposto Industrial (Lei n.º 19/14) as amended by Lei n.º 26/20 de 20 de Julho and Lei n.º 27/22, Código do Imposto sobre a Aplicação de Capitais (Decreto Legislativo Presidencial n.º 2/14 de 20 de Outubro); OGE 2025 (Lei n.º 18/24, in force 1 Jan 2025) art. 20-24 change none of the rates used"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (AoTax.country.computeWith args c).toJson :=
  conservative_pit model AoTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end AoGlobal
