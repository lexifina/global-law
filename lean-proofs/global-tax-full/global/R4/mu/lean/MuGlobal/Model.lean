import MuTax.Legacy
import MuGlobal.Consumption
import MuGlobal.Corporate
import MuGlobal.Social
import MuGlobal.Property
import MuGlobal.Other
import MuGlobal.Customs

/-! # MU: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace MuGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g ++ propertyNotes g ++ otherNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry MuTax.country) with
    families := [vat, excise, corporate, csg, nsf, hrdLevy, prgf, regDuty, ltt, fsc], unsupported,
    notes := ["Mauritius 2025 (R4)"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (MuTax.country.computeWith args c).toJson :=
  conservative_pit model MuTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end MuGlobal
