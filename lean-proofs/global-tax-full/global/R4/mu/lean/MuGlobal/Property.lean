import R4Common

/-! # MU 2025: Property (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/mu.json)

Registration duty on the transfer of immovable property (5 %) (Registration Duty Act (consolidated to Act 14 of 2026) s. 3, First Schedule Part I paras I and J (last amended by Act 37 of 2011, cio 15/12/11); Finance Act 2025 (Act 18 of 2025) and Finance Act 2026 checked: they do not amend paras I-J): First Schedule Part I: the adjudication, sale, resale, return and any other deed or judgment transferring an immovable property or its usufruct, with or without consideration, 5 % (para I where the price does not exceed 100 000 rupees, para J above). FA 2025 amended only s. 2, 2B, 3 (new s. 3(1G) for non-citizens from 1 July 2026), 14A, 17, 36, para K and Parts II and IV; FA 2026 repealed para K. The duty is borne by the buyer on the value.

Land transfer tax on the transfer of immovable property (5 %, paid by the transferor) (Land (Duties and Taxes) Act 1984 s. 4 (1), (4) (a)-(b) and Second Schedule Part A (2), MRA consolidation with amendments to Act 14 of 2026 (registry/afm_data/fetch/MU/TheLandAct.pdf.txt). 2025 wording: s. 4 (4) carries no amendment note (the paragraphs amended since 2012 all carry one) and the Second Schedule was last replaced by Act 26 of 2013 (1 January 2014) and amended by Act 15 of 2018 (15 April 2019, para (1) only), so the 5 % on the transferor holds all 2025. Split at 9 August 2025: s. 29 of Act 18 of 2025 added s. 4 (9) (repealed by Act 14 of 2026 from 13 August 2026; its text is not printed in the consolidation) and s. 4 (10) (a document transferring immovable with movable property without valuing each movable item: the tax on the aggregate value), both at the 10 % of Seventh Schedule Part III; s. 4 (11) (additional 10 % duty on non-citizen transfers) runs from 13 August 2026 only. Liability: the transferor (seller); charged on each disposal of the entity's land or buildings (event 'disposal i')): s. 4 (4): 'The tax shall be (a) paid by the transferor; (b) at the rate specified in the Second Schedule.' Second Schedule Part A, Transfer of immovable property: '(2) Transfer other than under paragraph (a) 5 per cent'. Twelfth pass (R4.disposalDutyFamily). -/

namespace MuGlobal
open TaxKernel TaxKernel.Global

def regDuty : Family :=
  R4.transferDutyFamily "Registration duty on the transfer of immovable property (5 %)" 500 [.home, .realEstate, .land] "Registration Duty Act (consolidated to Act 14 of 2026) s. 3, First Schedule Part I paras I and J (last amended by Act 37 of 2011, cio 15/12/11); Finance Act 2025 (Act 18 of 2025) and Finance Act 2026 checked: they do not amend paras I-J"

def regDutyT : CanonGlobal := { id := "h", household := { id := "h" }, purchases := [{ kind := .home, price := 1000000 }] }
#guard ((regDuty.run [] regDutyT []).map (·.due)) == [50000]

def ltt : Family :=
  R4.disposalDutyFamily "Land transfer tax on the transfer of immovable property (5 %, paid by the transferor)" [.home, .realEstate, .land] [] 500 false 0 "Land (Duties and Taxes) Act 1984 s. 4 (1), (4) (a)-(b) and Second Schedule Part A (2), MRA consolidation with amendments to Act 14 of 2026 (registry/afm_data/fetch/MU/TheLandAct.pdf.txt). 2025 wording: s. 4 (4) carries no amendment note (the paragraphs amended since 2012 all carry one) and the Second Schedule was last replaced by Act 26 of 2013 (1 January 2014) and amended by Act 15 of 2018 (15 April 2019, para (1) only), so the 5 % on the transferor holds all 2025. Split at 9 August 2025: s. 29 of Act 18 of 2025 added s. 4 (9) (repealed by Act 14 of 2026 from 13 August 2026; its text is not printed in the consolidation) and s. 4 (10) (a document transferring immovable with movable property without valuing each movable item: the tax on the aggregate value), both at the 10 % of Seventh Schedule Part III; s. 4 (11) (additional 10 % duty on non-citizen transfers) runs from 13 August 2026 only. Liability: the transferor (seller); charged on each disposal of the entity's land or buildings (event 'disposal i')"

def lttT : CanonGlobal := { id := "h", household := { id := "h" }, disposals := [{ kind := .home, proceeds := 1000000, cost := 0 }, { kind := .home, proceeds := 30000000, cost := 0 }], purchases := [{ kind := .home, price := 1000000 }] }
#guard ((ltt.run [] lttT []).map (·.due)) == [50000, 1500000]

def propertyNotes (g : CanonGlobal) : List String :=
  (if !(g.assets.isEmpty && g.purchases.isEmpty && g.disposals.isEmpty) then ["nineteenth pass (year in force, FT reviewer 7): s. 4 (4) (a)-(b) is the 2025 wording (no annotation); the 9 August 2025 additions (s. 4 (9), (10), 10 %) concern cases the model cannot see and are listed as unsupported; the 5 % rule computed applies on either side of that date"] else [])

end MuGlobal
