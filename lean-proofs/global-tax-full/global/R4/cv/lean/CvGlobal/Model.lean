import CvTax.Legacy
import CvGlobal.Consumption
import CvGlobal.Corporate
import CvGlobal.Social
import CvGlobal.Property
import CvGlobal.Customs

/-! # CV: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace CvGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry CvTax.country) with
    families := [vat, corporate, inps, iupTransmissao], unsupported,
    notes := ["Cabo Verde 2025 (R4): Código do IRPC (Lei n.º 82/VIII/2015) and Código do IRPS (Lei n.º 78/VIII/2014) as republished by Lei n.º 86/IX/2020 (B.O. I Série n.º 53, 28 Apr 2020); Lei n.º 16/X/2022 and Lei n.º 35/X/2023 (which also amend the CIRPC) not held; Orçamento do Estado 2025 checked (art. 25 amends CIRPC art. 68 only): grade B"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (CvTax.country.computeWith args c).toJson :=
  conservative_pit model CvTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end CvGlobal
