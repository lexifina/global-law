import CdTax.Legacy
import CdGlobal.Consumption
import CdGlobal.Corporate
import CdGlobal.Social
import CdGlobal.Capital
import CdGlobal.Absent

/-! # CD: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace CdGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g ++ capitalNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry CdTax.country) with
    families := [vat, excise, corporate, cnss, onem, inpp, imrDiv, imrInt], unsupported, absent := absentList,
    notes := ["DR Congo 2025 (R4): Code des impôts 2023 (DGI) and the 2023 ordinance-laws held; 2024-2025 finance laws not held: grade B"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (CdTax.country.computeWith args c).toJson :=
  conservative_pit model CdTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end CdGlobal
