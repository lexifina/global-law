import R4Common

/-! # BF 2025: Social (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/bf.json)

Taxe patronale et d'apprentissage (3 % of wages) (CGI 2023 art. 228-229 (edition at 2023; LF 2024/LFR 2024 checked; LF 2025 not held)): art. 228: base = all wages paid in money plus benefits in kind; art. 229: rate 3 %.

CNSS employer contributions (16 %: pensions 8,5 %, occupational risks 1,5 %, family benefits 6 %; ceiling 800 000 F a month) (Décret n° 2023-0129/PRES-TRANS/PM/MFPTPS/MEFP du 24 février 2023 art. 2-6 (effective 30 Aug 2022; repeals décret 2003-252); Arrêté n° 2022-067 du 30 août 2022 art. 2 (plafond); Loi n° 004-2021/AN art. 10-11 (cnss.bf PDFs via Wayback, R4/fetch/bf11, OCR)): Décret 2023-0129 art. 2: 'Le taux d'appel des cotisations ... est fixé à 16 % à la charge de l'employeur selon la ventilation suivante : 8,5 % au titre de la branche des pensions ; 1,5 % au titre de la branche des risques professionnels ; 6 % au titre de la branche des prestations familiales.'; art. 3: worker 5,5 % (pensions). Arrêté 2022-067 art. 2: 'Le plafond des salaires et revenus soumis à cotisation est de neuf millions six cent mille (9 600 000) francs CFA par assuré et par an soit huit cent mille (800 000) Francs CFA par assuré et par mois.' -/

namespace BfGlobal
open TaxKernel TaxKernel.Global

def tpa : Family :=
  R4.payrollFamily .payroll "Taxe patronale et d'apprentissage (3 % of wages)" 300 "CGI 2023 art. 228-229 (edition at 2023; LF 2024/LFR 2024 checked; LF 2025 not held)" (level := .central)

def tpaT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 1000000 } }
#guard ((tpa.run [] tpaT []).map (·.due)) == [30000]

def cnss : Family :=
  R4.payrollCapFamily .sscEmployer "CNSS employer contributions (16 %: pensions 8,5 %, occupational risks 1,5 %, family benefits 6 %; ceiling 800 000 F a month)" 1600 (9600000) "Décret n° 2023-0129/PRES-TRANS/PM/MFPTPS/MEFP du 24 février 2023 art. 2-6 (effective 30 Aug 2022; repeals décret 2003-252); Arrêté n° 2022-067 du 30 août 2022 art. 2 (plafond); Loi n° 004-2021/AN art. 10-11 (cnss.bf PDFs via Wayback, R4/fetch/bf11, OCR)" (level := .social)

def cnssT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 19200000, employees := 1 } }
#guard ((cnss.run [] cnssT []).map (·.due)) == [1536000]

def socialNotes (g : CanonGlobal) : List String :=
  (if (g.entity == .company || g.household.adults.any (·.wages > 0)) then ["2200 Assurance maladie universelle (CNAMU), employer contribution: not modelled (the decree fixing the contribution rate was not located (press reports of Nov 2025 give 5 %, half each, with benefits from 1 February 2026; not a rate text); collection for the 2025 year not established)"] else [])

end BfGlobal
