import BfTax.Legacy
import BfGlobal.Consumption
import BfGlobal.Corporate
import BfGlobal.Other
import BfGlobal.Capital
import BfGlobal.Social
import BfGlobal.Property
import BfGlobal.Transfers
import BfGlobal.Absent
import BfGlobal.Customs

/-! # BF: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace BfGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g ++ transfersNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry BfTax.country) with
    families := [vat, excise, corporate, patente, tvm, ircmDiv, ircmInt, irf, tpvi, tpa, cnss, cfBuilt, cfLand, mutImm, gratuit], unsupported, absent := absentList,
    notes := ["Burkina Faso 2025 (R4): CGI à jour LF 2023 (DGI); LF 2024 OCR held; LF 2025 not held: grade B"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (BfTax.country.computeWith args c).toJson :=
  conservative_pit model BfTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end BfGlobal
