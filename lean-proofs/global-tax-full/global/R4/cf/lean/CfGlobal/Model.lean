import CfTax.Legacy
import CfGlobal.Consumption
import CfGlobal.Corporate
import CfGlobal.Other
import CfGlobal.Transfers
import CfGlobal.Capital
import CfGlobal.Property
import CfGlobal.Social
import CfGlobal.Absent

/-! # CF: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace CfGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ transfersNotes g ++ capitalNotes g ++ propertyNotes g ++ socialNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry CfTax.country) with
    families := [vat, corporate, patente, tcvm, ircmDiv, ircmInt, cfpb, cfpnb, mutBati, mutNonBati, cnss], unsupported, absent := absentList,
    notes := ["Central African Republic 2025 (R4): CGI édition officielle mise à jour 2023 (DGID); LF 2025 pages 1-60 (no change found to these articles)"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (CfTax.country.computeWith args c).toJson :=
  conservative_pit model CfTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end CfGlobal
