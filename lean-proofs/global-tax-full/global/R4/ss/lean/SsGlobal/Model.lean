import SsTax.Legacy
import SsGlobal.Consumption
import SsGlobal.Corporate
import SsGlobal.Social
import SsGlobal.Customs

/-! # SS: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace SsGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry SsTax.country) with
    families := [vat, excise, corporate], unsupported,
    notes := ["South Sudan 2025 (R4): Financial Act 2024/2025 (FY July 2024 - June 2025), applied to 30 June 2025; the 2025/26 Act not found"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SsTax.country.computeWith args c).toJson :=
  conservative_pit model SsTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SsGlobal
