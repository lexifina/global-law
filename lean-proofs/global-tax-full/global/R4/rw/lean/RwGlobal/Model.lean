import RwTax.Legacy
import RwGlobal.Consumption
import RwGlobal.Corporate
import RwGlobal.Capital
import RwGlobal.Social
import RwGlobal.Customs

/-! # RW: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace RwGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ capitalNotes g ++ socialNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry RwTax.country) with
    families := [vat, excise, corporate, whtDiv, whtInt, pension, maternity, hazards], unsupported,
    notes := ["Rwanda 2025 (R4): Law Nº 027/2022 of 20/10/2022 on income taxes, as amended by Law Nº 051/2023 of 05/09/2023 and Law Nº 014/2025 of 27/05/2025"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (RwTax.country.computeWith args c).toJson :=
  conservative_pit model RwTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end RwGlobal
