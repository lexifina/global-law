import MzTax.Legacy
import MzGlobal.Consumption
import MzGlobal.Corporate
import MzGlobal.Other
import MzGlobal.Social
import MzGlobal.Property

/-! # MZ: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace MzGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry MzTax.country) with
    families := [vat, excise, corporate, isv, inss, sisa], unsupported,
    notes := ["Mozambique 2025 (R4): Código do IVA as amended by Lei n.º 22/2022 (from 2023) and Código do ICE approved by Lei n.º 19/2022 (rate table 2023-2025), both from the AT legislation library (at.gov.mz /api/documents); Código do IRPC (Lei n.º 34/2007) art. 61 n.º 1 and art. 62 n.º 2 as amended by Lei n.º 4/2012 (n.º 2 restated at 20 %), Lei n.º 19/2013 (n.º 1-2 unchanged) and Lei n.º 20/2022 (sector measures to 31 Dec 2025 only); Lei n.º 12/2025 applies from 1 Jan 2026"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (MzTax.country.computeWith args c).toJson :=
  conservative_pit model MzTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end MzGlobal
