import SnTax.Legacy
import SnGlobal.Consumption
import SnGlobal.Corporate
import SnGlobal.Capital
import SnGlobal.Social
import SnGlobal.Property
import SnGlobal.Transfers
import SnGlobal.Other
import SnGlobal.Absent
import SnGlobal.Customs

/-! # SN: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace SnGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g ++ transfersNotes g ++ otherNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry SnTax.country) with
    families := [vat, excise, corporate, divWht, intWht, cfce, css, ipres, foncier, regImm, mutGratuit, cel, tsvpm, timbreCarteGrise], unsupported, absent := absentList,
    notes := ["Senegal 2025 (R4): CGI annote janvier 2025 (LFI 2025)"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SnTax.country.computeWith args c).toJson :=
  conservative_pit model SnTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SnGlobal
