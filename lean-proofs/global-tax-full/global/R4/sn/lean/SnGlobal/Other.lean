import R4Common
import TaxKernel.Global2

/-! # SN 2025: Other (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/sn.json)

Contribution économique locale (CEL: rental value of premises + value added; replaced the patente in 2019) (CGI art. 320-321, 329-330, 336-337 (loi n° 2018-10 du 30 mars 2018; CGI annoté janvier 2025)): art. 330: 15 % of the rental value of rented or freely occupied premises, 20 % of premises entered in the balance sheet; art. 337: 1 % of the previous year's value added (art. 336: products less purchases, external services excluding rents over 3 months, other operating charges and taxes; capped at 70 % of turnover, art. 336-4), at least 0,15 % of turnover. Value added defaults to profit + payroll when the line gives none.

Taxe spéciale sur les voitures particulières des personnes morales (annual, by fiscal horsepower; companies only) (CGI 2025 (CGI annoté, janvier 2025), world/B07-west-africa-fr-pt/sn/src/CGI-2025.txt art. 550-554 (l. 13683-13800). Liability: the company or public establishment that held, used or maintained the car (art. 552)): art. 551: 'véhicule d'une puissance fiscale inférieure ou égale à 4 CV : 50.000 FCFA par an ; comprise entre 5 et 11 CV : 100.000 FCFA par an ; supérieure à 11 CV : 200.000 FCFA par an'. Worked case (hand): a company with cars of 4, 9 and 12 CV -> 50 000 + 100 000 + 200 000 = 350 000. Households' cars are outside this tax (nil tariff here). Sixteenth pass.

Droit de timbre on the registration certificate (carte grise) of a motor vehicle (2 000 F per fiscal horsepower) (CGI 2025 (CGI annoté, janvier 2025), world/B07-west-africa-fr-pt/sn/src/CGI-2025.txt art. 524 (Loi n° 2015-06 du 23 mars 2015), l. 13227-13235: 'Sont soumis à un droit de timbre de 2 000 francs : par cheval vapeur, les récépissés de déclaration de mise en circulation de véhicules automobiles ...'; public transport vehicles 1 000 F per CV): Worked case (hand): a car of 8 CV registered in 2025 -> 8 x 2 000 = 16 000 F; a car registered in 2019: nothing in 2025. Senegal has no annual vignette on private cars in the CGI 2025 (full-text search: 'vignette' occurs only for the patente); the 10 % taxe sur les véhicules de tourisme of 13 CV and more (art. 439-440) is an indirect tax on the supply or import (excise side), not modelled here. Sixteenth pass. -/

namespace SnGlobal
open TaxKernel TaxKernel.Global

def cel : Family :=
  R4.licenceFamily .useOfGoods "Contribution économique locale (CEL: rental value of premises + value added; replaced the patente in 2019)" { tiers := [], top := { ceil := 0, ppm := 0, floor := 0, cap := (-1), add := (0) }, rentPpm := (150000), ownedPpm := (200000), vaPpm := (10000), vaCapPpm := (700000), vaMinPpm := (1500) } "CGI art. 320-321, 329-330, 336-337 (loi n° 2018-10 du 30 mars 2018; CGI annoté janvier 2025)"

def celT0 : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { turnover := 3000000000, profit := 360000000, payroll := 240000000 }, raw := (Lean.Json.parse "{\"company\": {\"premisesRentalValue\": 60000000, \"premisesOwned\": false}}").toOption.getD Lean.Json.null }
#guard ((cel.run [] celT0 []).map (·.due)) == [9000000, 6000000]
def celT1 : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { turnover := 12000000000, profit := -180000000, payroll := 900000000 }, raw := (Lean.Json.parse "{\"company\": {\"premisesRentalValue\": 240000000, \"premisesOwned\": true}}").toOption.getD Lean.Json.null }
#guard ((cel.run [] celT1 []).map (·.due)) == [48000000, 18000000]
def celT2 : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { turnover := 1000000000, profit := 0, payroll := 0 }, raw := (Lean.Json.parse "{\"company\": {\"premisesRentalValue\": 0, \"premisesOwned\": false, \"valueAdded\": 900000000}}").toOption.getD Lean.Json.null }
#guard ((cel.run [] celT2 []).map (·.due)) == [7000000]

def tsvpm : Family :=
  R4.vehicleFamily "Taxe spéciale sur les voitures particulières des personnes morales (annual, by fiscal horsepower; companies only)" { bands := [], top := 0 } (some { bands := [(4, 50000), (11, 100000)], top := 200000 }) "CGI 2025 (CGI annoté, janvier 2025), world/B07-west-africa-fr-pt/sn/src/CGI-2025.txt art. 550-554 (l. 13683-13800). Liability: the company or public establishment that held, used or maintained the car (art. 552)"

def tsvpmT0 : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, raw := (Lean.Json.parse "{\"company\": {\"vehicles\": [{\"fiscalHp\": 4}, {\"fiscalHp\": 9}, {\"fiscalHp\": 12}]}}").toOption.getD Lean.Json.null }
#guard ((tsvpm.run [] tsvpmT0 []).map (·.due)) == [50000, 100000, 200000]
def tsvpmT1 : CanonGlobal := { id := "h", household := { id := "h" }, raw := (Lean.Json.parse "{\"assets\": [{\"kind\": \"vehicle\", \"value\": 1, \"fiscalHp\": 9}]}").toOption.getD Lean.Json.null }
#guard ((tsvpm.run [] tsvpmT1 []).map (·.due)) == [0]


def timbreCarteGriseTaxes : List VehicleTax := [{ name := "Droit de timbre sur le récépissé de mise en circulation (carte grise)", occasion := .registration, kinds := ["car"], parts := [(.fiscalHp, QtyTable.perUnit 2000 1)], statute := "CGI art. 524 (Loi 2015-06): 2 000 F per cheval vapeur on the récépissé de déclaration de mise en circulation" }]

def timbreCarteGrise : Family :=
  vehicleTaxFamily "Droit de timbre on the registration certificate (carte grise) of a motor vehicle (2 000 F per fiscal horsepower)" timbreCarteGriseTaxes

def timbreCarteGriseT0 : CanonGlobal :=
  match Lean.Json.parse "{\"id\": \"t0\", \"schema\": \"global/2.0\", \"household\": {\"id\": \"t0\", \"year\": 2025, \"adults\": [{\"age\": 40, \"wages\": 6000000}]}, \"assets\": [{\"kind\": \"vehicle\", \"value\": 12000000, \"fiscalHp\": 8, \"fuel\": \"petrol\", \"registeredThisYear\": true}]}" with
  | .ok j => (match parseGlobal j with | .ok g => g | .error _ => default)
  | .error _ => default
#guard ((timbreCarteGrise.run [] timbreCarteGriseT0 []).map (·.due)) == [16000]
def timbreCarteGriseT1 : CanonGlobal :=
  match Lean.Json.parse "{\"id\": \"t1\", \"schema\": \"global/2.0\", \"household\": {\"id\": \"t1\", \"year\": 2025, \"adults\": [{\"age\": 40, \"wages\": 6000000}]}, \"assets\": [{\"kind\": \"vehicle\", \"value\": 6000000, \"fiscalHp\": 8, \"fuel\": \"petrol\", \"firstRegYear\": 2019, \"registeredThisYear\": false}]}" with
  | .ok j => (match parseGlobal j with | .ok g => g | .error _ => default)
  | .error _ => default
#guard ((timbreCarteGrise.run [] timbreCarteGriseT1 []).map (·.due)) == []

def otherNotes (g : CanonGlobal) : List String :=
  vehicleTaxUnknown "Droit de timbre on the registration certificate (carte grise) of a motor vehicle (2 000 F per fiscal horsepower)" timbreCarteGriseTaxes g

end SnGlobal
