import UgTax.Legacy
import UgGlobal.Consumption
import UgGlobal.Corporate
import UgGlobal.Capital
import UgGlobal.Social
import UgGlobal.Other
import UgGlobal.Customs

/-! # UG: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace UgGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ capitalNotes g ++ socialNotes g ++ otherNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry UgTax.country) with
    families := [vat, excise, corporate, divWht, intWht, nssf, stampTransfer, stampListed], unsupported,
    notes := ["Uganda 2025 (R4): Income Tax Act Cap. 338, ULII consolidation at 2024-12-23 (the Income Tax (Amendment) Act 2025 of 1 July 2025 not checked)"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (UgTax.country.computeWith args c).toJson :=
  conservative_pit model UgTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end UgGlobal
