import BwTax.Legacy
import BwGlobal.Consumption
import BwGlobal.Corporate
import BwGlobal.Property
import BwGlobal.Capital
import BwGlobal.Absent
import BwGlobal.Customs

/-! # BW: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace BwGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ propertyNotes g ++ capitalNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry BwTax.country) with
    families := [vat, corporate, transferDuty, divWht], unsupported, absent := absentList,
    notes := ["Botswana 2025 (R4): Income Tax Act Cap. 52:01 (repealed by the Income Tax Act 2026 from 1 July 2026): rates as stated by the Botswana Unified Revenue Service pages 'Companies' (Wayback 19 Apr 2025) and 'Other Withholding Taxes' (Wayback 17 Sep 2025); the Act text for 2025 is not held: grade B"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (BwTax.country.computeWith args c).toJson :=
  conservative_pit model BwTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end BwGlobal
