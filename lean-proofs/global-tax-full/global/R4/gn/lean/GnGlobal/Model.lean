import GnTax.Legacy
import GnGlobal.Consumption
import GnGlobal.Corporate
import GnGlobal.Other
import GnGlobal.Transfers
import GnGlobal.Capital
import GnGlobal.Social
import GnGlobal.Property
import GnGlobal.Absent
import GnGlobal.Customs

/-! # GN: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace GnGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ transfersNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry GnTax.country) with
    families := [vat, excise, corporate, patente, ircmDiv, ircmInt, ipvi, vf, cnss, cfuHome, cfuLet, mutImm], unsupported, absent := absentList,
    notes := ["Guinea 2025 (R4): CGI 2021 (Loi 2021-32) with LF 2024 OCR; LF 2025 not held: grade B"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (GnTax.country.computeWith args c).toJson :=
  conservative_pit model GnTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end GnGlobal
