import StTax.Legacy
import StGlobal.Consumption
import StGlobal.Corporate
import StGlobal.Social

/-! # ST: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace StGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry StTax.country) with
    families := [vat, corporate, inss], unsupported,
    notes := ["Sao Tome and Principe 2025 (R4): Lei n.º 13/2019 (Código do IVA, D.R. I Série n.º 71 of 6 Nov 2019), Lei n.º 10/2009 (Código do IRC) and Decreto-Lei n.º 6/2016 (contribuição mínima) as amended by the OGE 2024 law (art. 8 n.º 10; its tax changes stay in force until the next OGE law); the OGE 2025 law is not held: grade B"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (StTax.country.computeWith args c).toJson :=
  conservative_pit model StTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end StGlobal
