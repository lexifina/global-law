import LsTax.Legacy
import LsGlobal.Consumption
import LsGlobal.Corporate
import LsGlobal.Absent
import LsGlobal.Customs

/-! # LS: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace LsGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry LsTax.country) with
    families := [vat, excise, corporate], unsupported, absent := absentList,
    notes := ["Lesotho 2025 (R4): Income Tax Act 1993 consolidated to 1 April 2012 (the copy the Revenue Services Lesotho site publishes as its current Act, uploaded 2024); later Finance Acts not held: grade B, flagged. VAT: Value Added Tax Act 2001 s. 6 (2) and Value Added Tax Regulations 2003 (LN 95 of 2003) reg. 6 as amended by LN 27 of 2018, LN 34 of 2019, LN 18 of 2020 and LN 30 of 2021"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (LsTax.country.computeWith args c).toJson :=
  conservative_pit model LsTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end LsGlobal
