import R4Common

/-! # GA 2025: Social (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/ga.json)

CNAMGS employer contribution (private sector) (Décret n°0022 art. 38 (4,1 %), monthly ceiling 2 500 000 F (CNAMGS)): CNAMGS, 'Payement des cotisations employeurs' (archived 2025-08-15): "Le plafond mensuel des salaires soumis à cotisation est de 2 500 000 FCFA ... Secteur privé: (Décret n°0022 … art. 38) Cotisations patronales : 4,1 % ; Cotisations salariales : 2 %". The decree itself not held: grade B. Annual ceiling 12 x 2 500 000.

Prélèvement pour le Fonds national de l'habitat (2 % up to the CNSS ceiling) (CGI 2025 art. 401-404 (rate and base, read); CNSS ceiling 1 500 000 F a month: CLEISS 'Les cotisations au Gabon', table 'Taux de cotisation au 1er janvier 2023' as shown on 6 May 2025 (Wayback 20250506125305, R4/fetch/p16/cleiss_gabon_wb20250506.html) (the same ceiling on the 2026 page)): art. 401: wages 'constituant l'assiette des cotisations du régime des prestations familiales et des accidents du travail dans la limite du plafond fixé par la Caisse Nationale de Sécurité Sociale' are subject to the levy; art. 402: private and public employers (except the State) under the CNSS; art. 403: 'Le taux du prélèvement pour le Fonds National de l'Habitat est fixé à 2 %.'

CNSS employer contributions in 2025 (family 8 %, work accidents 3 %, pensions 5 %; up to 1 500 000 F a month) (CLEISS 'Les cotisations au Gabon', table 'Taux de cotisation au 1er janvier 2023' as shown on 6 May 2025 (Wayback 20250506125305, R4/fetch/p16/cleiss_gabon_wb20250506.html); the 2026 page (R4/fetch/cleiss11/gabon.html, 'au 1er janvier 2026': family 5 %, work accidents 2 %, pensions 11 %) gives the reform decree's rates from 1 January 2026, not applied to 2025; CNSS decrees not read): CLEISS as at May 2025 (rates of 1 January 2023, in force through 2025): prestations familiales 8 %, accidents du travail 3 %, pensions 5 % (employer; employee 2,5 %), monthly ceiling 1 500 000 FCFA; assurance maladie (CNAMGS) 4,1 % / 2 % up to 2 500 000. The pension reform (16 % = 11 % employer + 5 % employee; family 5 %, work accidents 2 %) applies from 1 January 2026 (CLEISS 2026 page; decree of late 2025 per press). Sixteenth pass (year-in-force fix; was 18 % from the 2026 page). -/

namespace GaGlobal
open TaxKernel TaxKernel.Global

def cnamgs : Family :=
  R4.payrollCapFamily .sscEmployer "CNAMGS employer contribution (private sector)" 410 (30000000) "Décret n°0022 art. 38 (4,1 %), monthly ceiling 2 500 000 F (CNAMGS)" (level := .social)

def cnamgsT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 60000000, employees := 1 } }
#guard ((cnamgs.run [] cnamgsT []).map (·.due)) == [1230000]

def fnh : Family :=
  R4.payrollCapFamily .payroll "Prélèvement pour le Fonds national de l'habitat (2 % up to the CNSS ceiling)" 200 (18000000) "CGI 2025 art. 401-404 (rate and base, read); CNSS ceiling 1 500 000 F a month: CLEISS 'Les cotisations au Gabon', table 'Taux de cotisation au 1er janvier 2023' as shown on 6 May 2025 (Wayback 20250506125305, R4/fetch/p16/cleiss_gabon_wb20250506.html) (the same ceiling on the 2026 page)" (level := .central)

def fnhT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 36000000, employees := 1 } }
#guard ((fnh.run [] fnhT []).map (·.due)) == [360000]

def cnss : Family :=
  R4.payrollCapFamily .sscEmployer "CNSS employer contributions in 2025 (family 8 %, work accidents 3 %, pensions 5 %; up to 1 500 000 F a month)" 1600 (18000000) "CLEISS 'Les cotisations au Gabon', table 'Taux de cotisation au 1er janvier 2023' as shown on 6 May 2025 (Wayback 20250506125305, R4/fetch/p16/cleiss_gabon_wb20250506.html); the 2026 page (R4/fetch/cleiss11/gabon.html, 'au 1er janvier 2026': family 5 %, work accidents 2 %, pensions 11 %) gives the reform decree's rates from 1 January 2026, not applied to 2025; CNSS decrees not read" (level := .social)

def cnssT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 36000000, employees := 1 } }
#guard ((cnss.run [] cnssT []).map (·.due)) == [2880000]

def socialNotes (g : CanonGlobal) : List String :=
  (if (g.entity == .company || g.household.adults.any (·.wages > 0)) then ["CNAMGS 4,1 % up to 2 500 000 F a month (CNAMGS page; decree not held); CNSS employer contributions not modelled"] else [])

end GaGlobal
