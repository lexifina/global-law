import GaTax.Legacy
import GaGlobal.Consumption
import GaGlobal.Corporate
import GaGlobal.Capital
import GaGlobal.Social
import GaGlobal.Property
import GaGlobal.Transfers
import GaGlobal.Other
import GaGlobal.Absent

/-! # GA: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace GaGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g ++ transfersNotes g ++ otherNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry GaTax.country) with
    families := [vat, excise, corporate, ircm, ircmInt, tsil, cnamgs, fnh, cnss, regImm, cfuHome, cfuOther, succession, donation, patente, vehLuxe], unsupported, absent := absentList,
    notes := ["Gabon 2025 (R4): CGI 2025"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (GaTax.country.computeWith args c).toJson :=
  conservative_pit model GaTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end GaGlobal
