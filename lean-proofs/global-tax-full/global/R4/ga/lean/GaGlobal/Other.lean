def patenteT0 : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { turnover := 500000000, profit := 0, payroll := 0 }, raw := (Lean.Json.parse "{\"company\": {\"premisesRentalValue\": 0, \"premisesOwned\": false}}").toOption.getD Lean.Json.null }
#guard ((patente.run [] patenteT0 []).map (·.due)) == [170000]
def patenteT1 : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { turnover := 5000000000, profit := 0, payroll := 0 }, raw := (Lean.Json.parse "{\"company\": {\"premisesRentalValue\": 30000000, \"premisesOwned\": false}}").toOption.getD Lean.Json.null }
#guard ((patente.run [] patenteT1 []).map (·.due)) == [170000]


def vehLuxeTaxes : List VehicleTax := [{ name := "Taxe sur les véhicules de luxe (vehicle up to 5 years old)", kinds := ["car"], fuels := [.petrol, .diesel, .hybrid, .pluginHybrid, .lpg, .cng, .hydrogen, .other], «when» := [(.fiscalHp, 10, VehicleTax.noBound), (.age, -1, 4)], parts := [(.fiscalHp, { steps := [(10, 20000)], den := 1 })], proRata := false, statute := "CGI 2025 taxe sur les véhicules de luxe art. 6, 8: 20 000 FCFA per fiscal horsepower above 10 CV, new vehicles and under 5 years" }, { name := "Taxe sur les véhicules de luxe (vehicle over 5 years old)", kinds := ["car"], fuels := [.petrol, .diesel, .hybrid, .pluginHybrid, .lpg, .cng, .hydrogen, .other], «when» := [(.fiscalHp, 10, VehicleTax.noBound), (.age, 4, VehicleTax.noBound)], parts := [(.fiscalHp, { steps := [(10, 30000)], den := 1 })], proRata := false, statute := "CGI 2025 taxe sur les véhicules de luxe art. 6, 8: 30 000 FCFA per fiscal horsepower above 10 CV, vehicles over 5 years" }]

