import EtTax.Legacy
import EtGlobal.Consumption
import EtGlobal.Corporate
import EtGlobal.Other
import EtGlobal.Capital
import EtGlobal.Social

/-! # ET: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace EtGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ capitalNotes g ++ socialNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry EtTax.country) with
    families := [vat, excise, corporate, stampTitle, divTax, intTax, poessa], unsupported,
    notes := ["Ethiopia 2025 (R4): VAT Proclamation No. 1341/2024 (Federal Negarit Gazette No. 61, 21 August 2024); tax year EFY 2017 (8 July 2024 - 7 July 2025) holds most of 2025"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (EtTax.country.computeWith args c).toJson :=
  conservative_pit model EtTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end EtGlobal
