-- dated 2025-08-07: 10 %
#guard ((intTax.run [] (intTaxT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"incomes\":[{\"kind\":\"interest\",\"amount\":1000000,\"date\":\"2025-08-07\"}]}") []).map (·.due)) == [100000]

def capitalNotes (g : CanonGlobal) : List String :=
  (if !(g.incomes.isEmpty && g.disposals.isEmpty) then ["1100 Schedule B rental income tax of individuals (0-35 % bands on annual taxable rental income): not modelled (the bands of art. 14 (2) as replaced apply to income derived from 8 July 2025 (art. 4 (3)), i.e. to the tax year EFY 2018 (8 July 2025-7 July 2026); income derived from 1 January to 7 July 2025 belongs to EFY 2017, taxed on that year's whole rental income under the Proclamation 979/2016 bands (not re-read): a calendar-2025 rent cannot be split between the two tax years' band schedules (twentieth pass: B -> C))"] else []) ++ R4.datedFinalWhtNotes .dividend "Schedule D dividend income tax (10 % to 6 August 2025, 15 % from 7 August)" divTaxPeriods "no date given and the rate changed on 7 August 2025 (10 -> 15 %, Proclamation 1395/2025 art. 4 (2))" g ++ R4.datedFinalWhtNotes .interest "Schedule D interest income tax (10 % from 7 August 2025)" intTaxPeriods "dated before 7 August 2025 or undated: Proclamation 979/2016 art. 56 then applied (5 % on savings deposits; the kind of deposit is not an input and the other art. 56 rates were not re-read)" g

