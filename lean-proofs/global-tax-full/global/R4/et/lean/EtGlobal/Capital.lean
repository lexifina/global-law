import R4Common
import R4Common.Dated

/-! # ET 2025: Capital (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/et.json)

Schedule D dividend income tax (10 % to 6 August 2025, 15 % from 7 August) (Federal Income Tax Proclamation 979/2016 art. 57 as replaced by Income Tax (Amendment) Proclamation 1395/2025 (Negarit Gazette No. 64, 1 September 2025), Schedule D effective 7 August 2025 (art. 4(2)) [text version: Proclamation No. 1395/2025 as published (Federal Negarit Gazette No. 64, 1 September 2025); to 6 August 2025 the Proclamation No. 979/2016 rate (10 %); split by the income record's date (twentieth pass)]): art. 57(1) (new): a resident deriving a dividend is liable at 15 % of the gross dividend, for Schedule D tax collected from 7 August 2025 (art. 4 (2)); before, the Proclamation 979/2016 rate of 10 %. The rate is read from the dividend's date; an undated dividend is not computed (grade C).

Schedule D interest income tax (10 % from 7 August 2025) (Proclamation 979/2016 art. 56, renumbered art. 58 and replaced by Proclamation 1395/2025, effective 7 August 2025 [text version: Proclamation No. 1395/2025 as published (Federal Negarit Gazette No. 64, 1 September 2025); interest dated before 7 August 2025 (Proclamation No. 979/2016 art. 56) not computed (twentieth pass)]): art. 58(1) (new): a resident deriving interest is liable at 10 % of the gross interest. -/

namespace EtGlobal
open TaxKernel TaxKernel.Global

def divTaxPeriods : List R4.DatedRate := [{ rateBp := 1000, validFrom := "", validTo := "2025-08-07", statute := "Proclamation 979/2016 (dividends 10 %), to 6 August 2025" }, { rateBp := 1500, validFrom := "2025-08-07", validTo := "", statute := "Proclamation 979/2016 art. 57 as replaced by Proclamation 1395/2025 (15 %), Schedule D tax collected from 7 August 2025 (art. 4 (2))" }]

def divTax : Family :=
  R4.datedFinalWhtFamily .dividend "Schedule D dividend income tax (10 % to 6 August 2025, 15 % from 7 August)" divTaxPeriods

def divTaxT (s : String) : CanonGlobal :=
  match Lean.Json.parse s with
  | .ok j => (match parseGlobal j with | .ok g => g | .error _ => default)
  | .error _ => default
-- dated 2025-01-01: 10 %
#guard ((divTax.run [] (divTaxT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"incomes\":[{\"kind\":\"dividend\",\"amount\":1000000,\"date\":\"2025-01-01\"}]}") []).map (·.due)) == [100000]
-- dated 2025-08-07: 15 %
#guard ((divTax.run [] (divTaxT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"incomes\":[{\"kind\":\"dividend\",\"amount\":1000000,\"date\":\"2025-08-07\"}]}") []).map (·.due)) == [150000]

def intTaxPeriods : List R4.DatedRate := [{ rateBp := 1000, validFrom := "2025-08-07", validTo := "", statute := "Proclamation 979/2016 art. 58 (renumbered) as replaced by Proclamation 1395/2025 (10 %), Schedule D tax collected from 7 August 2025 (art. 4 (2))" }]

