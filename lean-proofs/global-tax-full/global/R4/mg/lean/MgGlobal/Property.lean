import R4Common

/-! # MG 2025: Property (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/mg.json)

Impôt foncier sur la propriété bâtie (CGI art. 10.02.10 (5 % of the rental value; minimum Ar 5 000) [text version: CGI, édition 2025 incorporating the LFI 2025 (Loi de finances initiale 2025)]): art. 10.02.10: "La taxe est calculée par application d'un taux fixe de 5p.100 à la valeur locative fixée par les dispositions de l'article 10.02.06. Toutefois, l'impôt dû ne doit pas être inférieur à Ar 5 000 par immeuble." The land tax (IFT, art. 10.01.07) is a communal tariff per hectare or a voted percentage: not modelled.

Droit de vente d'immeubles (CGI art. 02.02.39 1° (5 %) [text version: CGI, édition 2025 incorporating the LFI 2025 (Loi de finances initiale 2025)]): art. 02.02.39: "1° Les adjudications, ventes, reventes, cessions, rétrocessions, et tous autres actes civils et judiciaires translatifs de propriété ou d'usufruit de biens immeubles à titre onéreux sont assujettis à un droit de 5p.100." -/

namespace MgGlobal
open TaxKernel TaxKernel.Global

def ifpb : Family :=
  let f := R4.propertyFamily "Impôt foncier sur la propriété bâtie" 500 0 "CGI art. 10.02.10 (5 % of the rental value; minimum Ar 5 000) [text version: CGI, édition 2025 incorporating the LFI 2025 (Loi de finances initiale 2025)]"; { f with run := fun a g c => (f.run a g c).filter (fun x => x.event.endsWith "(built)") }

def ifpbT : CanonGlobal := { id := "h", household := { id := "h" }, assets := [{ kind := .home, value := 0, annualValue := 1000000 }, { kind := .land, value := 1000000 }] }
#guard ((ifpb.run [] ifpbT []).map (·.due)) == [50000]

def regImm : Family :=
  R4.transferDutyFamily "Droit de vente d'immeubles" 500 [.home, .realEstate, .land] "CGI art. 02.02.39 1° (5 %) [text version: CGI, édition 2025 incorporating the LFI 2025 (Loi de finances initiale 2025)]"

def regImmT : CanonGlobal := { id := "h", household := { id := "h" }, purchases := [{ kind := .home, price := 1000000 }] }
#guard ((regImm.run [] regImmT []).map (·.due)) == [50000]

def propertyNotes (g : CanonGlobal) : List String :=
  (if !(g.assets.isEmpty && g.purchases.isEmpty && g.disposals.isEmpty) then ["IFPB 5 % on annualValue (minimum Ar 5 000 not applied); IFT on land: communal tariffs (art. 10.01.07), not modelled"] else [])

end MgGlobal
