import R4Common

/-! # MG 2025: Capital (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/mg.json)

Impôt sur les revenus des capitaux mobiliers (dividendes) (CGI art. 01.04.04 (20 %, libératoire) [text version: CGI, édition 2025 incorporating the LFI 2025 (Loi de finances initiale 2025)]): art. 01.04.04: "Le taux de l'impôt sur le revenu des capitaux mobiliers est fixé à 20p.100 ... Le paiement de l'impôt sur le revenu des capitaux mobiliers est libératoire, sur justification, de l'impôt sur les revenus des personnes morales et physiques".

Impôt sur les plus-values immobilières (CGI art. 01.05.04 (gain = price − 75 % of the price), art. 01.05.07 (20 %): 5 % of the price [text version: CGI, édition 2025 incorporating the LFI 2025 (Loi de finances initiale 2025)]): art. 01.05.04: "La plus-value imposable est constituée par la différence entre : le prix de cession ... et le prix de revient fixé forfaitairement à 75% du montant susmentionné"; art. 01.05.07: "L'Impôt est calculé en appliquant à la plus-value imposable le taux de 20p.100". So the tax is 20 % x 25 % = 5 % of the price. -/

namespace MgGlobal
open TaxKernel TaxKernel.Global

def ircmDiv : Family :=
  R4.finalWhtFamily .dividend "Impôt sur les revenus des capitaux mobiliers (dividendes)" 2000 "CGI art. 01.04.04 (20 %, libératoire) [text version: CGI, édition 2025 incorporating the LFI 2025 (Loi de finances initiale 2025)]"

def ircmDivT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .dividend, amount := 1000000 }] }
#guard ((ircmDiv.run [] ircmDivT []).map (·.due)) == [200000]

def ircmInt : Family :=
  R4.finalWhtFamily .interest "Impôt sur les revenus des capitaux mobiliers (intérêts)" 2000 "CGI art. 01.04.04 (20 %) [text version: CGI, édition 2025 incorporating the LFI 2025 (Loi de finances initiale 2025)]"

def ircmIntT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .interest, amount := 1000000 }] }
#guard ((ircmInt.run [] ircmIntT []).map (·.due)) == [200000]

def ipvi : Family :=
  R4.gainsFamily "Impôt sur les plus-values immobilières" 500 [.home, .realEstate, .land] "CGI art. 01.05.04 (gain = price − 75 % of the price), art. 01.05.07 (20 %): 5 % of the price [text version: CGI, édition 2025 incorporating the LFI 2025 (Loi de finances initiale 2025)]" (onProceeds := true)

def ipviT : CanonGlobal := { id := "h", household := { id := "h" }, disposals := [{ kind := .home, proceeds := 5000000, cost := 3000000 }] }
#guard ((ipvi.run [] ipviT []).map (·.due)) == [250000]

def capitalNotes (g : CanonGlobal) : List String :=
  (if !(g.incomes.isEmpty && g.disposals.isEmpty) then ["CGI art. 01.04.04: 10 % on cooperative distributions not applied; the scope article (01.04.01) not checked for bank-deposit interest exemptions"] else []) ++ (if !(g.incomes.isEmpty && g.disposals.isEmpty) then ["IPVI: the administrative minimum value of the price (art. 01.05.04) and the exclusions of art. 01.05.03 not applied"] else [])

end MgGlobal
