import MgTax.Legacy
import MgGlobal.Consumption
import MgGlobal.Corporate
import MgGlobal.Capital
import MgGlobal.Social
import MgGlobal.Property
import MgGlobal.Transfers
import MgGlobal.Absent

/-! # MG: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace MgGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g ++ transfersNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry MgTax.country) with
    families := [vat, excise, corporate, ircmDiv, ircmInt, ipvi, cnaps, smie, fmfp, ifpb, regImm, mutGratuit], unsupported, absent := absentList,
    notes := ["Madagascar 2025 (R4): CGI suivant LFI 2025"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (MgTax.country.computeWith args c).toJson :=
  conservative_pit model MgTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end MgGlobal
