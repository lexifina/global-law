import ZwTax.Legacy
import ZwGlobal.Consumption
import ZwGlobal.Corporate
import ZwGlobal.Other
import ZwGlobal.Social
import ZwGlobal.Capital

/-! # ZW: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace ZwGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g ++ capitalNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry ZwTax.country) with
    families := [vat, corporate, stampImmovable, zinara, rst], unsupported,
    notes := ["Zimbabwe 2025 (R4): Finance Act 2025 (No. 7 of 2025) s. 34 (quotes the 2025 wording of the VAT general rate); Finance Acts 2023, 2024, 2024 (No. 2)"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (ZwTax.country.computeWith args c).toJson :=
  conservative_pit model ZwTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end ZwGlobal
