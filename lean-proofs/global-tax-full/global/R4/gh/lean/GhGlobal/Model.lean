import GhTax.Legacy
import GhGlobal.Consumption
import GhGlobal.Corporate
import GhGlobal.Other
import GhGlobal.Capital
import GhGlobal.Social
import GhGlobal.Stack
import GhGlobal.Customs

/-! # GH: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace GhGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ capitalNotes g ++ socialNotes g

def model : GlobalModel :=
  (({ (GlobalModel.ofCountry GhTax.country) with
    families := [vat, corporate, stampConv, gsl, divWht, rentWht, ssnit], unsupported,
    notes := ["Ghana 2025 (R4): VAT Act 2013 (Act 870) and Income Tax Act 2015 (Act 896) as enacted (later amendments not consolidated in the local copies): grade B"] } : GlobalModel).withStack [ghGains]).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (GhTax.country.computeWith args c).toJson :=
  conservative_pit model GhTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end GhGlobal
