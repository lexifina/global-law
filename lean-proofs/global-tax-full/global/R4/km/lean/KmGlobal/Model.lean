import KmTax.Legacy
import KmGlobal.Consumption
import KmGlobal.Corporate
import KmGlobal.Property
import KmGlobal.Other
import KmGlobal.Capital
import KmGlobal.Social
import KmGlobal.Absent

/-! # KM: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace KmGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ propertyNotes g ++ otherNotes g ++ capitalNotes g ++ socialNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry KmTax.country) with
    families := [vat, excise, corporate, regImm, patente, vignette, pvImm], unsupported, absent := absentList,
    notes := ["Comoros 2025 (R4): CGI 2022 (local OCR) and LF 2024 pages 1-60; LF 2025 not held: grade B"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (KmTax.country.computeWith args c).toJson :=
  conservative_pit model KmTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end KmGlobal
