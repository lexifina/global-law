import R4Common

/-! # KE 2025: Capital (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/ke.json)

Withholding tax on dividends (resident) (ITA Third Schedule Head B para 5 (a) (15 %)): Head B para 5: "The resident withholding tax rates shall be- (a) in respect of a dividend, fifteen per cent of the amount payable; (b) in respect of interest ... (i) bearer instrument ... twenty-five per cent; (ii) Government Bearer Bond of at least two years duration and other sources, fifteen per cent".

Residential rental income tax (ITA s. 6A; Third Schedule Head B para 10 (7,5 % of gross rent)): s. 6A (1): "a tax to be known as residential rental income tax shall be payable ... by any resident person from income ... for the use or occupation of residential property, and which is in excess of two hundred and eighty-eight thousand shillings but does not exceed fifteen million shillings during any year of income"; Head B para 10: "The rate of tax in respect of residential rental income shall be seven point five percent of the gross rental receipts". The 288 000 / 15 000 000 band is not applied (rent items assumed inside it): grade B.

Capital gains tax (ITA s. 3 (2) (f); Third Schedule Head B para 14 (15 %, final)): Head B para 14: "The rate of tax in respect of capital gains charged under section 3(2)(f) shall be fifteen per cent which shall be a final tax". Gain = proceeds less cost and costs (Eighth Schedule adjusted cost not read in detail). -/

namespace KeGlobal
open TaxKernel TaxKernel.Global

def divWht : Family :=
  R4.finalWhtFamily .dividend "Withholding tax on dividends (resident)" 1500 "ITA Third Schedule Head B para 5 (a) (15 %)"

def divWhtT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .dividend, amount := 1000000 }] }
#guard ((divWht.run [] divWhtT []).map (·.due)) == [150000]

def intWht : Family :=
  R4.finalWhtFamily .interest "Withholding tax on interest (resident)" 1500 "ITA Third Schedule Head B para 5 (b) (ii) (15 %)"

def intWhtT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .interest, amount := 1000000 }] }
#guard ((intWht.run [] intWhtT []).map (·.due)) == [150000]

def rentTax : Family :=
  R4.finalWhtFamily .rent "Residential rental income tax" 750 "ITA s. 6A; Third Schedule Head B para 10 (7,5 % of gross rent)"

def rentTaxT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .rent, amount := 1000000 }] }
#guard ((rentTax.run [] rentTaxT []).map (·.due)) == [75000]

def cgt : Family :=
  R4.gainsFamily "Capital gains tax" 1500 [.realEstate, .land, .unlistedShares] "ITA s. 3 (2) (f); Third Schedule Head B para 14 (15 %, final)"

def cgtT : CanonGlobal := { id := "h", household := { id := "h" }, disposals := [{ kind := .realEstate, proceeds := 5000000, cost := 3000000 }] }
#guard ((cgt.run [] cgtT []).map (·.due)) == [300000]

def capitalNotes (g : CanonGlobal) : List String :=
  (if !(g.incomes.isEmpty && g.disposals.isEmpty) then ["ITA Head B para 5 (b): bearer instruments 25 %, 10-year bearer bonds 10 %: household interest taken as 'other sources' (15 %)"] else []) ++ (if !(g.incomes.isEmpty && g.disposals.isEmpty) then ["ITA s. 6A: the household's rent items are assumed to lie in the 288 000 - 15 000 000 Sh band"] else []) ++ (if !(g.incomes.isEmpty && g.disposals.isEmpty) then ["CGT: homes and listed shares are not taxed here (Eighth Schedule exemptions not read)"] else [])

end KeGlobal
