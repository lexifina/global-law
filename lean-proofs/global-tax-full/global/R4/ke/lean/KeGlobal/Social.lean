import R4Common

/-! # KE 2025: Social (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/ke.json)

Affordable Housing Levy (employer) (Affordable Housing Act 2024 s. 4 (2), 5 (1) (b) (1.5 %)): AHA 2024 s. 4 (2): "The Levy shall be at the rate of one point five percent of- (a) the gross salary of an employee"; s. 5 (1): "An employer shall- (a) deduct and remit ... and (b) remit an amount equivalent to the amount deducted under section 4(2)(a)".

NSSF Tier I + Tier II employer contribution (6 % of pensionable earnings up to the Upper Earnings Limit) (National Social Security Fund Act 2013 (Cap. 258) s. 20, Third Schedule (Table: year 2 UEL = 1 × National Average Earnings, year 3 LEL 8 000 / UEL = 2 × NAE); year 3 runs from February 2025): s. 20: the employer pays Tier I contributions (6 % of earnings up to the Lower Earnings Limit) and Tier II contributions (6 % of earnings between the LEL and the Upper Earnings Limit), matching the employee; pensionable earnings are the lower of monthly wages and the UEL. Third Schedule: year 2 (February 2024 - January 2025) UEL = 1 × NAE, year 3 (February 2025 - January 2026) UEL = 2 × NAE. NAE = 36 000 Kshs, inferred from the NSSF year-4 notice (UEL 108 000 = 3 × NAE) — the year-3 notice itself is not held. For 2025: January at 6 % of up to 36 000, February-December at 6 % of up to 72 000, i.e. an annual ceiling of 36 000 + 11 × 72 000 = 828 000 per employee.

Industrial training levy (NITA), KES 600 per employee per year (Industrial Training Act (Cap. 237) s. 5A; Industrial Training (Training Levy) Order, L.N. 113 of 2007, para. 4 (1) as amended by L.N. 10 of 2020 and L.N. 62 of 2021 (Kenya Law revised edition 31 Dec 2022, Wayback 2025-10-28, R4/fetch/p14/ke_nita_order.txt)): Para. 4 (1): 'At the end of each financial year ... an employer shall remit to the Director a levy of six hundred shillings per employee per year or pro rata for their term of service.' 'employee' includes apprentices, temporary, seasonal and casual workers (para. 2). Fourteenth pass (FT reviewer 4 gap). -/

namespace KeGlobal
open TaxKernel TaxKernel.Global

def ahl : Family :=
  R4.payrollFamily .payroll "Affordable Housing Levy (employer)" 150 "Affordable Housing Act 2024 s. 4 (2), 5 (1) (b) (1.5 %)" (level := .central)

def ahlT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 1000000 } }
#guard ((ahl.run [] ahlT []).map (·.due)) == [15000]

def nssf : Family :=
  R4.payrollCapFamily .sscEmployer "NSSF Tier I + Tier II employer contribution (6 % of pensionable earnings up to the Upper Earnings Limit)" 600 (828000) "National Social Security Fund Act 2013 (Cap. 258) s. 20, Third Schedule (Table: year 2 UEL = 1 × National Average Earnings, year 3 LEL 8 000 / UEL = 2 × NAE); year 3 runs from February 2025" (level := .social)

def nssfT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 1656000, employees := 1 } }
#guard ((nssf.run [] nssfT []).map (·.due)) == [49680]

def nita : Family :=
  R4.payrollHeadFamily .payroll "Industrial training levy (NITA), KES 600 per employee per year" 600 "Industrial Training Act (Cap. 237) s. 5A; Industrial Training (Training Levy) Order, L.N. 113 of 2007, para. 4 (1) as amended by L.N. 10 of 2020 and L.N. 62 of 2021 (Kenya Law revised edition 31 Dec 2022, Wayback 2025-10-28, R4/fetch/p14/ke_nita_order.txt)" (level := .central)

def nitaT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 1000000, employees := 12 } }
#guard ((nita.run [] nitaT []).map (·.due)) == [7200]

def socialNotes (g : CanonGlobal) : List String :=
  (if (g.entity == .company || g.household.adults.any (·.wages > 0)) then ["NITA levy: a company line with a payroll but no employee count gets no charge (the count is not guessed)"] else [])

end KeGlobal
