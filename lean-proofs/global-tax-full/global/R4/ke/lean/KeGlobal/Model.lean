import KeTax.Legacy
import KeGlobal.Consumption
import KeGlobal.Corporate
import KeGlobal.Capital
import KeGlobal.Social
import KeGlobal.Property
import KeGlobal.Customs

/-! # KE: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace KeGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry KeTax.country) with
    families := [vat, excise, corporate, divWht, intWht, rentTax, cgt, ahl, nssf, nita, stamp], unsupported,
    notes := ["Kenya 2025 (R4): Kenya Law consolidations at 2025-07-01"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (KeTax.country.computeWith args c).toJson :=
  conservative_pit model KeTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end KeGlobal
