import R4Common

/-! # TG 2025: Social (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/tg.json)

CNSS employer contributions (CNSS Togo (rates fixed by decree): family 3 %, occupational risks 2 %, pensions 12,5 %): CNSS Togo, 'Cotisations sociales' (official site, w5/tg_cnss_cotis.txt): "Le taux de cotisation sociale est de 21,5%. ... la branche des prestations familiales pour 3%, la branche des risques professionnels ... pour 2%, une part de la branche des pensions de vieillesse pour 12,50%. Les 4% à la charge du travailleur salarié". The decree itself not held (grade B); no ceiling stated.

Assurance maladie obligatoire (employer share) (Décret n° 2023-096 art. 12 (10 %, at least half by the employer)): Décret 2023-096 art. 12: "Le taux de cotisation dû par les travailleurs salariés au titre du régime d'assurance maladie obligatoire est fixé à 10 % des rémunérations mensuelles soumises à cotisation, dont 50% au moins à la charge de l'employeur et le reste à la charge du travailleur." The statutory minimum employer share (5 %) is applied. -/

namespace TgGlobal
open TaxKernel TaxKernel.Global

def cnss : Family :=
  R4.payrollCapFamily .sscEmployer "CNSS employer contributions" 1750 (-1) "CNSS Togo (rates fixed by decree): family 3 %, occupational risks 2 %, pensions 12,5 %" (level := .social)

def cnssT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 1000000, employees := 1 } }
#guard ((cnss.run [] cnssT []).map (·.due)) == [175000]

def amu : Family :=
  R4.payrollCapFamily .sscEmployer "Assurance maladie obligatoire (employer share)" 500 (-1) "Décret n° 2023-096 art. 12 (10 %, at least half by the employer)" (level := .social)

def amuT : CanonGlobal := { id := "c", entity := .company, household := { id := "c" }, company := { payroll := 1000000, employees := 1 } }
#guard ((amu.run [] amuT []).map (·.due)) == [50000]

def socialNotes (g : CanonGlobal) : List String :=
  (if (g.entity == .company || g.household.adults.any (·.wages > 0)) then ["CNSS employer 17,5 % from the CNSS official page (decree not held); ceiling, if any, not applied"] else []) ++ (if (g.entity == .company || g.household.adults.any (·.wages > 0)) then ["AMU: employer share taken at the statutory minimum (half of 10 %)"] else [])

end TgGlobal
