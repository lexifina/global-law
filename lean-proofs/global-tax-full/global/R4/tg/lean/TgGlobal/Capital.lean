/-- the gain less the holding-period reduction (gen_pkgs gains.holdReduce) -/
def pvBase (d : Disposal) : Int :=
  let gn := pos d.gain
  let red : Int := if ([.home, .realEstate] : List AssetKind).contains d.kind && d.heldMonths > 60 then 2000 else if ([.land] : List AssetKind).contains d.kind && d.heldMonths > 60 then 1000 else if ([.listedShares, .unlistedShares] : List AssetKind).contains d.kind && d.heldMonths > 24 then 1000 else 0
  gn - divR .down (red * gn) BP

/-- exempt by the proceeds threshold (gen_pkgs gains.exemptProceeds) -/
def pvExempt (d : Disposal) : Bool := ([.realEstate, .land, .home] : List AssetKind).contains d.kind && d.proceeds ≤ 2000000

def pv : Family :=
  { name := "1100 " ++ "Taxe sur les plus-values de cession d'immeubles et d'actions ou parts sociales (7 %, libératoire)", covers := [],
    run := fun _ g _ =>
      if g.entity == .company then [] else
      (g.disposals.zipIdx.filter (fun (d, _) => ([.home, .realEstate, .land, .listedShares, .unlistedShares] : List AssetKind).contains d.kind && !(true && d.mainHome) && !(pvExempt d))).map fun (d, i) =>
        charge .pit "Taxe sur les plus-values de cession d'immeubles et d'actions ou parts sociales (7 %, libératoire)" (pvBase d) id (fun y => divR .down (700 * pos y) BP)
          (event := s!"disposal {i + 1}") (statute := "CGI art. 82 (gains on immovables and on shares of companies registered in Togo, 'à titre libératoire'), art. 84 (exemptions), art. 85 and 88 (base), art. 90 ('7% en ce qui concerne les cessions d'immeubles ou de droits immobiliers et d'actions ou de parts sociales') [text version: CGI 2025 (OTR edition 'CGI et LPF 2025', otr_cgi_lpf_2025.txt)]") }

