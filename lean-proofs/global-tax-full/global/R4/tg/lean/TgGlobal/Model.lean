import TgTax.Legacy
import TgGlobal.Consumption
import TgGlobal.Corporate
import TgGlobal.Capital
import TgGlobal.Social
import TgGlobal.Property
import TgGlobal.Transfers
import TgGlobal.Other
import TgGlobal.Absent
import TgGlobal.Customs

/-! # TG: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace TgGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g ++ transfersNotes g ++ otherNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry TgTax.country) with
    families := [vat, excise, corporate, divWht, intWht, pv, cnss, amu, foncier, regImm, succession, patente, tvm], unsupported, absent := absentList,
    notes := ["Togo 2025 (R4): CGI-LPF edition 2025 (OTR)"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (TgTax.country.computeWith args c).toJson :=
  conservative_pit model TgTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end TgGlobal
