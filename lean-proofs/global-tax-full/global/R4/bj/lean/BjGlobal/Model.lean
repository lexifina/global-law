import BjTax.Legacy
import BjGlobal.Consumption
import BjGlobal.Corporate
import BjGlobal.Transfers
import BjGlobal.Other
import BjGlobal.Capital
import BjGlobal.Social
import BjGlobal.Property
import BjGlobal.Absent
import BjGlobal.Customs

/-! # BJ: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace BjGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ transfersNotes g ++ otherNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry BjTax.country) with
    families := [vat, excise, corporate, donation, patente, tvm, ircmDiv, ircmInt, irf, tpvi, vps, cnss, tfu, mutImm], unsupported, absent := absentList,
    notes := ["Benin 2025 (R4): CGI 2023 edition"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (BjTax.country.computeWith args c).toJson :=
  conservative_pit model BjTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end BjGlobal
