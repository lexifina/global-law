import ScTax.Legacy
import ScGlobal.Consumption
import ScGlobal.Corporate
import ScGlobal.Social
import ScGlobal.Customs

/-! # SC: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace ScGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry ScTax.country) with
    families := [vat, excise, corporate], unsupported,
    notes := ["Seychelles 2025 (R4): Value Added Tax Act 2010 (Cap 244) with its Schedules as replaced by S.I. 4 of 2014 (rate in the Third Schedule) and later amendments to 2025; Business Tax Act 2009 (Cap 20) First Schedule as replaced by S.I. 27 of 2010 and amended to S.I. 107 of 2024 (from 1 Jan 2025); Excise Tax (Rates) Regulations 2023 (S.I. 110 of 2023, from 1 Jan 2024) as amended by S.I. 31 and 56 of 2024; sugar tax S.I. 55 of 2023"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (ScTax.country.computeWith args c).toJson :=
  conservative_pit model ScTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end ScGlobal
