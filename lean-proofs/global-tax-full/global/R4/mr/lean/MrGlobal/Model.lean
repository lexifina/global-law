import MrTax.Legacy
import MrGlobal.Consumption
import MrGlobal.Corporate
import MrGlobal.Transfers
import MrGlobal.Other
import MrGlobal.Capital
import MrGlobal.Social
import MrGlobal.Property
import MrGlobal.Absent
import MrGlobal.Local

/-! # MR: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace MrGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ transfersNotes g ++ otherNotes g ++ capitalNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry MrTax.country) with
    families := [vat, excise, corporate, donation, patente, tvm, ircmDiv, ircmInt, irf, ta, cnss, cnam, mutImm], unsupported, absent := absentList,
    notes := ["Mauritania 2025 (R4): CGI 2023 (French text, DGI); LF 2025 held in Arabic only (not read): grade B"] } : GlobalModel).withLocalTaxes [mrFonciere]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (MrTax.country.computeWith args c).toJson :=
  conservative_pit model MrTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end MrGlobal
