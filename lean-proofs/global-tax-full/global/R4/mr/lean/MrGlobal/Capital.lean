import R4Common

/-! # MR 2025: Capital (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/mr.json)

Impôt sur le revenu des capitaux mobiliers, dividends (10 %) (CGI 2023 (French edition) art. 119-120, 126 (LFI 2024/2025 held in Arabic only, not read)): art. 126: 20 % on gains on securities where the seller is in a privileged-tax State, 10 % in all other cases.

Impôt sur le revenu des capitaux mobiliers, interest on claims and deposits (10 %) (CGI 2023 art. 119, 121, 122, 126): art. 119: IRCM on income from claims, deposits and guarantees; art. 126: 10 %; art. 122: savings-bank passbook interest and interest on bank accounts of households up to 100 000 MRU a year are exempt.

Impôt sur les revenus fonciers (10 % of rents due) (CGI 2023 art. 102, 105): art. 102: taxable income = total rents due in the previous year, rounded down to 10 MRU; landlords whose only income is rent of at most 6 000 MRU a year are exempt; art. 105: rate 10 %. -/

namespace MrGlobal
open TaxKernel TaxKernel.Global

def ircmDiv : Family :=
  R4.finalWhtFamily .dividend "Impôt sur le revenu des capitaux mobiliers, dividends (10 %)" 1000 "CGI 2023 (French edition) art. 119-120, 126 (LFI 2024/2025 held in Arabic only, not read)"

def ircmDivT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .dividend, amount := 1000000 }] }
#guard ((ircmDiv.run [] ircmDivT []).map (·.due)) == [100000]

def ircmInt : Family :=
  R4.finalWhtFamily .interest "Impôt sur le revenu des capitaux mobiliers, interest on claims and deposits (10 %)" 1000 "CGI 2023 art. 119, 121, 122, 126"

def ircmIntT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .interest, amount := 1000000 }] }
#guard ((ircmInt.run [] ircmIntT []).map (·.due)) == [100000]

def irf : Family :=
  R4.finalWhtFamily .rent "Impôt sur les revenus fonciers (10 % of rents due)" 1000 "CGI 2023 art. 102, 105"

def irfT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .rent, amount := 1000000 }] }
#guard ((irf.run [] irfT []).map (·.due)) == [100000]

def capitalNotes (g : CanonGlobal) : List String :=
  []

end MrGlobal
