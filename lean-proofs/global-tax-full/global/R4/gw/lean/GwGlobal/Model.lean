import GwTax.Legacy
import GwGlobal.Consumption
import GwGlobal.Corporate
import GwGlobal.Social
import GwGlobal.Customs

/-! # GW: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace GwGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ socialNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry GwTax.country) with
    families := [vat], unsupported,
    notes := ["Guinea-Bissau 2025 (R4): Lei n.º 4/2022 (Código do IVA, 4.º Suplemento ao Boletim Oficial n.º 8, 25 Feb 2022), which repeals the Código do IGV (Lei n.º 16/97); the date from which the IVA is actually applied is not stated in the texts held; OGE laws 2023-2025 not read: grade B"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (GwTax.country.computeWith args c).toJson :=
  conservative_pit model GwTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end GwGlobal
