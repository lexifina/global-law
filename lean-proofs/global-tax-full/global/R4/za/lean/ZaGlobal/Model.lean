import ZaTax.Legacy
import ZaGlobal.Consumption
import ZaGlobal.Corporate
import ZaGlobal.Other
import ZaGlobal.Social
import ZaGlobal.Property
import ZaGlobal.Transfers
import ZaGlobal.Capital
import ZaGlobal.Absent
import ZaGlobal.Stack
import ZaGlobal.Customs

/-! # ZA: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace ZaGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g ++ propertyNotes g ++ transfersNotes g ++ capitalNotes g

def model : GlobalModel :=
  (({ (GlobalModel.ofCountry ZaTax.country) with
    families := [vat, excise, corporate, stt, healthPromotionLevy, uif, sdl, transferDuty, estateDuty, donationsTax, divTax], unsupported, absent := absentList,
    notes := ["South Africa 2025 (R4): Rates and Monetary Amounts and Amendment of Revenue Laws Acts 21 of 2018, 19 of 2023, 45 of 2024 and 3 of 2026 (official PDFs from sars.gov.za, Government Gazette prints); SARS rate pages for the dividends tax"] } : GlobalModel).withStack [zaCgt]).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (ZaTax.country.computeWith args c).toJson :=
  conservative_pit model ZaTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end ZaGlobal
