import TdTax.Legacy
import TdGlobal.Consumption
import TdGlobal.Corporate
import TdGlobal.Capital
import TdGlobal.Other
import TdGlobal.Social
import TdGlobal.Property
import TdGlobal.Absent

/-! # TD: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace TdGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ capitalNotes g ++ otherNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  { (GlobalModel.ofCountry TdTax.country) with
    families := [vat, corporate, ircm, intWht, pv, patente, tvs, taxeForfaitaire, taxeApprentissage, cnps, cfpb], unsupported, absent := absentList,
    notes := ["Chad 2025 (R4): CGI 2016 as amended by LF 2023 (art. 238), LF 2024 (DGI circular) and LF 2025 (OCR, in force 1 Jan 2025)"] }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (TdTax.country.computeWith args c).toJson :=
  conservative_pit model TdTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end TdGlobal
