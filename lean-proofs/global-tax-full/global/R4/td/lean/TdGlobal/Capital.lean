import R4Common

/-! # TD 2025: Capital (P3-P7; generated by R4/tools/gen_pkgs.py from specs/pkgs/td.json)

Retenue IRCM (revenus distribués) (CGI art. 82 (nouveau), LF 2025 art. 23 (18 %)): LF 2025 art. 23, art. 82 (nouveau): "Les revenus des capitaux mobiliers entrant dans les provisions des articles 74 à 78 donnent lieu à l'application d'une retenue à la source au taux est de 18%."

Retenue sur revenus des créances (CGI art. 118 (18 %, LF 2024 per the DGI circular)): DGI circular on LF 2024, para. 27: "Les dispositions nouvelles de l'article 118 du CGI visent à ramener le taux de retenue à la source applicable aux revenus des capitaux mobiliers ... revenus des créances, dépôts et cautionnements ainsi que les intérêts de bon de caisse, de 20% à 18%".

Retenue sur les plus-values (CGI art. 90 (nouveau), LF 2025 art. 24 (18 %)): LF 2025 art. 24: "Article 90 (ancien) Les plus-values sont soumises à une retenue de 20 % du montant net des plus-values. Lire: Article 90 (nouveau) Les plus-values sont soumises à une retenue de 18 %." -/

namespace TdGlobal
open TaxKernel TaxKernel.Global

def ircm : Family :=
  R4.finalWhtFamily .dividend "Retenue IRCM (revenus distribués)" 1800 "CGI art. 82 (nouveau), LF 2025 art. 23 (18 %)"

def ircmT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .dividend, amount := 1000000 }] }
#guard ((ircm.run [] ircmT []).map (·.due)) == [180000]

def intWht : Family :=
  R4.finalWhtFamily .interest "Retenue sur revenus des créances" 1800 "CGI art. 118 (18 %, LF 2024 per the DGI circular)"

def intWhtT : CanonGlobal := { id := "h", household := { id := "h" }, incomes := [{ kind := .interest, amount := 1000000 }] }
#guard ((intWht.run [] intWhtT []).map (·.due)) == [180000]

def pv : Family :=
  R4.gainsFamily "Retenue sur les plus-values" 1800 [.listedShares, .unlistedShares, .realEstate, .land, .home] "CGI art. 90 (nouveau), LF 2025 art. 24 (18 %)"

def pvT : CanonGlobal := { id := "h", household := { id := "h" }, disposals := [{ kind := .listedShares, proceeds := 5000000, cost := 3000000 }] }
#guard ((pv.run [] pvT []).map (·.due)) == [360000]

def capitalNotes (g : CanonGlobal) : List String :=
  (if !(g.incomes.isEmpty && g.disposals.isEmpty) then ["CGI art. 90 (LF 2025): 18 % on the net gain; the scope of art. 90 (which gains) not re-read: applied to every disposal"] else [])

end TdGlobal
