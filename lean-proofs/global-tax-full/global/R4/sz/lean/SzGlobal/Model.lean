import SzTax.Legacy
import SzGlobal.Consumption
import SzGlobal.Corporate
import SzGlobal.Other
import SzGlobal.Social
import SzGlobal.Property
import SzGlobal.Absent
import SzGlobal.Customs

/-! # SZ: kernel-2.0 model (generated by R4/tools/mk_model.py; families one file each, DESIGN.md §6) -/

namespace SzGlobal
open TaxKernel TaxKernel.Global

def unsupported (_ : List String) (g : CanonGlobal) : List String :=
  consumptionNotes g ++ corporateNotes g ++ otherNotes g ++ socialNotes g ++ propertyNotes g

def model : GlobalModel :=
  ({ (GlobalModel.ofCountry SzTax.country) with
    families := [vat, excise, corporate, stampTransferDeed, enpf, transferDuty], unsupported, absent := absentList,
    notes := ["Eswatini 2025 (R4): VAT Act 2011 with the VAT (Rates) Regulations (LN 52 of 2012 as amended by LN 112 of 2018) and LN 130 of 2025; ERS guide pages (live 2026-11-21) for the company rate and withholding taxes"] } : GlobalModel).withCustoms [tariff]

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SzTax.country.computeWith args c).toJson :=
  conservative_pit model SzTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SzGlobal
