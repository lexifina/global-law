import CuGlobal.Pit
import CuGlobal.Consumption
import CuGlobal.Corporate
import CuGlobal.Capital
import CuGlobal.Social
import CuGlobal.Transfers

/-! # Cuba: kernel-2.0 model (generated by americas/tools/gen_model.py from the family files present:
Consumption, Corporate, Capital, Social, Transfers) -/

namespace CuGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Consumption.families ++ Corporate.families ++ Capital.families ++ Social.families ++ Transfers.families,
    absent := Consumption.absent ++ Corporate.absent ++ Capital.absent ++ Social.absent ++ Transfers.absent,
    notes := Consumption.notes ++ Corporate.notes ++ Capital.notes ++ Social.notes ++ Transfers.notes,
    unsupported := fun args g => Consumption.unsupported args g ++ Corporate.unsupported args g ++ Capital.unsupported args g ++ Social.unsupported args g ++ Transfers.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (CuTax.country.computeWith args c).toJson :=
  conservative_pit model CuTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end CuGlobal
