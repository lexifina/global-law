import UsGlobal.Pit
import UsGlobal.Consumption
import UsGlobal.Corporate
import UsGlobal.Capital
import UsGlobal.Social
import UsGlobal.Property
import UsGlobal.Transfers

/-! # United States: kernel-2.0 model (generated by americas/tools/gen_model.py from the family files present:
Consumption, Corporate, Capital, Social, Property, Transfers) -/

namespace UsGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Consumption.families ++ Corporate.families ++ Capital.families ++ Social.families ++ Property.families ++ Transfers.families,
    absent := Consumption.absent ++ Corporate.absent ++ Capital.absent ++ Social.absent ++ Property.absent ++ Transfers.absent,
    notes := Consumption.notes ++ Corporate.notes ++ Capital.notes ++ Social.notes ++ Property.notes ++ Transfers.notes,
    unsupported := fun args g => Consumption.unsupported args g ++ Corporate.unsupported args g ++ Capital.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Transfers.unsupported args g }

/-- Every 1.x output unchanged: the PIT is the 1.x exe's own line function on the household's input line. -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = pitLine args c.raw := rfl

end UsGlobal
