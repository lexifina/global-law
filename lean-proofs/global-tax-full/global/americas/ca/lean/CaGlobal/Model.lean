import CaGlobal.Pit
import CaGlobal.Consumption
import CaGlobal.Corporate
import CaGlobal.Capital
import CaGlobal.Social
import CaGlobal.Transfers

/-! # Canada: kernel-2.0 model (generated by americas/tools/gen_model.py from the family files present:
Consumption, Corporate, Capital, Social, Transfers) -/

namespace CaGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Consumption.families ++ Corporate.families ++ Capital.families ++ Social.families ++ Transfers.families,
    absent := Consumption.absent ++ Corporate.absent ++ Capital.absent ++ Social.absent ++ Transfers.absent,
    notes := Consumption.notes ++ Corporate.notes ++ Capital.notes ++ Social.notes ++ Transfers.notes,
    unsupported := fun args g => Consumption.unsupported args g ++ Corporate.unsupported args g ++ Capital.unsupported args g ++ Social.unsupported args g ++ Transfers.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (CaTax.country.computeWith args c).toJson :=
  conservative_pit model CaTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end CaGlobal
