import SgGlobal.Pit
import SgGlobal.Corporate
import SgGlobal.Social
import SgGlobal.Property
import SgGlobal.Transfers
import SgGlobal.Consumption
import SgGlobal.Customs
import SgGlobal.Other

/-! # Singapore: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Social, Property, Transfers, Consumption, Customs, Other) -/

namespace SgGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Social.families ++ Property.families ++ Transfers.families ++ Consumption.families ++ Customs.families ++ Other.families,
    absent := Corporate.absent ++ Social.absent ++ Property.absent ++ Transfers.absent ++ Consumption.absent ++ Customs.absent ++ Other.absent,
    notes := Corporate.notes ++ Social.notes ++ Property.notes ++ Transfers.notes ++ Consumption.notes ++ Customs.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Transfers.unsupported args g ++ Consumption.unsupported args g ++ Customs.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SgTax.country.computeWith args c).toJson :=
  conservative_pit model SgTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SgGlobal
