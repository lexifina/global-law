import NzGlobal.Pit
import NzGlobal.Corporate
import NzGlobal.Transfers
import NzGlobal.Consumption
import NzGlobal.Customs
import NzGlobal.Other
import NzGlobal.Stack

/-! # New Zealand: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Transfers, Consumption, Customs, Other) -/

namespace NzGlobal
open TaxKernel TaxKernel.Global

def model0 : GlobalModel :=
  { base with
    families := Corporate.families ++ Transfers.families ++ Consumption.families ++ Customs.families ++ Other.families,
    absent := Corporate.absent ++ Transfers.absent ++ Consumption.absent ++ Customs.absent ++ Other.absent,
    notes := Corporate.notes ++ Transfers.notes ++ Consumption.notes ++ Customs.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Transfers.unsupported args g ++ Consumption.unsupported args g ++ Customs.unsupported args g ++ Other.unsupported args g }

/-- Kernel 2.5.0: income stacked on the 1.x income tax (`NzGlobal.Stack.rules`), added last. -/
def model : GlobalModel := model0.withStack Stack.rules

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model0_pit (args : List String) (c : Canon) :
    (model0.computeGlobal args (CanonGlobal.ofCanon c)).pit = (NzTax.country.computeWith args c).toJson :=
  conservative_pit model0 NzTax.country (fun _ _ => rfl) (fun _ => rfl) args c

/-- The 1.x PIT line is unchanged by the stacking (kernel `withStack_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (model0.computeGlobal args (CanonGlobal.ofCanon c)).pit :=
  withStack_pit model0 Stack.rules _ args _

end NzGlobal
