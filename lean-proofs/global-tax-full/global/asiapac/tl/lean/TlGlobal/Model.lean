import TlGlobal.Pit
import TlGlobal.Corporate
import TlGlobal.Capital
import TlGlobal.Social
import TlGlobal.Consumption
import TlGlobal.Other

/-! # Timor-Leste: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Capital, Social, Consumption, Other) -/

namespace TlGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Capital.families ++ Social.families ++ Consumption.families ++ Other.families,
    absent := Corporate.absent ++ Capital.absent ++ Social.absent ++ Consumption.absent ++ Other.absent,
    notes := Corporate.notes ++ Capital.notes ++ Social.notes ++ Consumption.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Capital.unsupported args g ++ Social.unsupported args g ++ Consumption.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (TlTax.country.computeWith args c).toJson :=
  conservative_pit model TlTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end TlGlobal
