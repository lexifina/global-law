import BnGlobal.Pit
import BnGlobal.Corporate
import BnGlobal.Social
import BnGlobal.Consumption
import BnGlobal.Other

/-! # Brunei: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Social, Consumption, Other) -/

namespace BnGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Social.families ++ Consumption.families ++ Other.families,
    absent := Corporate.absent ++ Social.absent ++ Consumption.absent ++ Other.absent,
    notes := Corporate.notes ++ Social.notes ++ Consumption.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Social.unsupported args g ++ Consumption.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (BnTax.country.computeWith args c).toJson :=
  conservative_pit model BnTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end BnGlobal
