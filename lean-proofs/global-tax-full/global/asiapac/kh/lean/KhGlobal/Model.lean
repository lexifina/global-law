import KhGlobal.Pit
import KhGlobal.Corporate
import KhGlobal.Social
import KhGlobal.Property
import KhGlobal.Consumption
import KhGlobal.Customs
import KhGlobal.Other

/-! # Cambodia: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Social, Property, Consumption, Customs, Other) -/

namespace KhGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Social.families ++ Property.families ++ Consumption.families ++ Customs.families ++ Other.families,
    absent := Corporate.absent ++ Social.absent ++ Property.absent ++ Consumption.absent ++ Customs.absent ++ Other.absent,
    notes := Corporate.notes ++ Social.notes ++ Property.notes ++ Consumption.notes ++ Customs.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Consumption.unsupported args g ++ Customs.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (KhTax.country.computeWith args c).toJson :=
  conservative_pit model KhTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end KhGlobal
