import WsGlobal.Pit
import WsGlobal.Corporate
import WsGlobal.Capital
import WsGlobal.Social
import WsGlobal.Property
import WsGlobal.Consumption
import WsGlobal.Other

/-! # Samoa: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Capital, Social, Property, Consumption, Other) -/

namespace WsGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Capital.families ++ Social.families ++ Property.families ++ Consumption.families ++ Other.families,
    absent := Corporate.absent ++ Capital.absent ++ Social.absent ++ Property.absent ++ Consumption.absent ++ Other.absent,
    notes := Corporate.notes ++ Capital.notes ++ Social.notes ++ Property.notes ++ Consumption.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Capital.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Consumption.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (WsTax.country.computeWith args c).toJson :=
  conservative_pit model WsTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end WsGlobal
