import NpGlobal.Pit
import NpGlobal.Corporate
import NpGlobal.Capital
import NpGlobal.Social
import NpGlobal.Consumption
import NpGlobal.Customs
import NpGlobal.Other

/-! # Nepal: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Capital, Social, Consumption, Customs, Other) -/

namespace NpGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Capital.families ++ Social.families ++ Consumption.families ++ Customs.families ++ Other.families,
    absent := Corporate.absent ++ Capital.absent ++ Social.absent ++ Consumption.absent ++ Customs.absent ++ Other.absent,
    notes := Corporate.notes ++ Capital.notes ++ Social.notes ++ Consumption.notes ++ Customs.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Capital.unsupported args g ++ Social.unsupported args g ++ Consumption.unsupported args g ++ Customs.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (NpTax.country.computeWith args c).toJson :=
  conservative_pit model NpTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end NpGlobal
