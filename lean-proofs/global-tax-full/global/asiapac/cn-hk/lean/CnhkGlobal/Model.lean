import CnhkGlobal.Pit
import CnhkGlobal.Corporate
import CnhkGlobal.Capital
import CnhkGlobal.Property
import CnhkGlobal.Transfers
import CnhkGlobal.Consumption
import CnhkGlobal.Other

/-! # Hong Kong SAR: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Capital, Property, Transfers, Consumption, Other) -/

namespace CnhkGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Capital.families ++ Property.families ++ Transfers.families ++ Consumption.families ++ Other.families,
    absent := Corporate.absent ++ Capital.absent ++ Property.absent ++ Transfers.absent ++ Consumption.absent ++ Other.absent,
    notes := Corporate.notes ++ Capital.notes ++ Property.notes ++ Transfers.notes ++ Consumption.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Capital.unsupported args g ++ Property.unsupported args g ++ Transfers.unsupported args g ++ Consumption.unsupported args g ++ Other.unsupported args g }

/-- No 1.x model: the PIT line is the stub (`pitLine`), on every household. -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = pitLine args c := rfl

end CnhkGlobal
