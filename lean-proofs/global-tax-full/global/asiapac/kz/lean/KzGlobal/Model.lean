import KzGlobal.Pit
import KzGlobal.Corporate
import KzGlobal.Capital
import KzGlobal.Social
import KzGlobal.Property
import KzGlobal.Consumption
import KzGlobal.Customs
import KzGlobal.Other

/-! # Kazakhstan: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Capital, Social, Property, Consumption, Customs, Other) -/

namespace KzGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Capital.families ++ Social.families ++ Property.families ++ Consumption.families ++ Customs.families ++ Other.families,
    absent := Corporate.absent ++ Capital.absent ++ Social.absent ++ Property.absent ++ Consumption.absent ++ Customs.absent ++ Other.absent,
    notes := Corporate.notes ++ Capital.notes ++ Social.notes ++ Property.notes ++ Consumption.notes ++ Customs.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Capital.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Consumption.unsupported args g ++ Customs.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (KzTax.country.computeWith args c).toJson :=
  conservative_pit model KzTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end KzGlobal
