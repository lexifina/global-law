import LaGlobal.Pit

/-!
# Laos 2025: other taxes and cited absences (P7)

Generated by `tools/mkother.py` from the R3 registry for every P3-P7 heading that no other family file models, cites or
lists: a cited absence (B) where the registry records the tax as not levied, a C entry (not modelled) where it is levied.
-/

namespace LaGlobal.Other
open TaxKernel TaxKernel.Global

def families : List Family := []

def absent : List Absent :=
  [{ oecd := .payroll, why := "Payroll taxes: not levied in 2025 (R3 registry, registry/ASIA_PACIFIC.json: none); grade B, no statute text read for the negative" },
   { oecd := .wealth, why := "Net wealth tax: not levied in 2025 (R3 registry, registry/ASIA_PACIFIC.json: none); grade B, no statute text read for the negative" },
   { oecd := .estate, why := "Inheritance, estate and gift taxes: not levied in 2025 (R3 registry, registry/ASIA_PACIFIC.json: none); grade B, no statute text read for the negative" },
   { oecd := .transactions, why := "4400: no tax on property transfers in 2025. PwC Worldwide Tax Summaries, Lao PDR, Individual - Other taxes (last reviewed 14 August 2025, Wayback capture 2025-09-12, asiapac/la/law/pwc_la_indother_wb20250912.txt) and Deloitte Lao PDR Highlights 2025 (updated January 2025, asiapac/la/law/deloitte_la_2025.txt) both state that Laos levies no transfer tax; the OECD Revenue Statistics detailed table for Lao PDR (sdmx.oecd.org DSD_REV_ASAP@DF_REVLAO 2.1, fetched 2026-11-22, asiapac/la/law/oecd_LAO.csv) books 0 under 4400 in 2021, 2022, 2023 and 2024. fixed documentary stamps (PwC: LAK 2,000 to 20,000 a document) and document registration fees (Deloitte) are charges on documents with no value base, not modelled Grade B (guides and official revenue table; no statute read)." }]

def notes : List String := ["LA P7: 4 cited absences, 1 levied taxes not modelled (C)"]

def unsupported (_ : List String) (_ : CanonGlobal) : List String := []

#guard absent.length == 4

end LaGlobal.Other
