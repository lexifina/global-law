import KpGlobal.Pit
import KpGlobal.Corporate
import KpGlobal.Consumption
import KpGlobal.Other

/-! # North Korea: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Consumption, Other) -/

namespace KpGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Consumption.families ++ Other.families,
    absent := Corporate.absent ++ Consumption.absent ++ Other.absent,
    notes := Corporate.notes ++ Consumption.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Consumption.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (KpTax.country.computeWith args c).toJson :=
  conservative_pit model KpTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end KpGlobal
