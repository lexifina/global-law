import BdGlobal.Pit
import BdGlobal.Corporate
import BdGlobal.Capital
import BdGlobal.Property
import BdGlobal.Transfers
import BdGlobal.Consumption
import BdGlobal.Customs
import BdGlobal.Other

/-! # Bangladesh: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Capital, Property, Transfers, Consumption, Customs, Other) -/

namespace BdGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Capital.families ++ Property.families ++ Transfers.families ++ Consumption.families ++ Customs.families ++ Other.families,
    absent := Corporate.absent ++ Capital.absent ++ Property.absent ++ Transfers.absent ++ Consumption.absent ++ Customs.absent ++ Other.absent,
    notes := Corporate.notes ++ Capital.notes ++ Property.notes ++ Transfers.notes ++ Consumption.notes ++ Customs.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Capital.unsupported args g ++ Property.unsupported args g ++ Transfers.unsupported args g ++ Consumption.unsupported args g ++ Customs.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (BdTax.country.computeWith args c).toJson :=
  conservative_pit model BdTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end BdGlobal
