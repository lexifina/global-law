import SbGlobal.Pit
import SbGlobal.Corporate
import SbGlobal.Social
import SbGlobal.Property
import SbGlobal.Consumption
import SbGlobal.Other

/-! # Solomon Islands: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Social, Property, Consumption, Other) -/

namespace SbGlobal
open TaxKernel TaxKernel.Global

def model : GlobalModel :=
  { base with
    families := Corporate.families ++ Social.families ++ Property.families ++ Consumption.families ++ Other.families,
    absent := Corporate.absent ++ Social.absent ++ Property.absent ++ Consumption.absent ++ Other.absent,
    notes := Corporate.notes ++ Social.notes ++ Property.notes ++ Consumption.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Consumption.unsupported args g ++ Other.unsupported args g }

/-- Every 1.x output unchanged (kernel theorem `conservative_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (SbTax.country.computeWith args c).toJson :=
  conservative_pit model SbTax.country (fun _ _ => rfl) (fun _ => rfl) args c

end SbGlobal
