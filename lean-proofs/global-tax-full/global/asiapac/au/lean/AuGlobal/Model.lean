import AuGlobal.Pit
import AuGlobal.Corporate
import AuGlobal.Social
import AuGlobal.Property
import AuGlobal.Transfers
import AuGlobal.Consumption
import AuGlobal.Customs
import AuGlobal.Other
import AuGlobal.Stack

/-! # Australia: kernel-2.0 model (generated by asiapac/tools/gen_model.py from the family files present:
Corporate, Social, Property, Transfers, Consumption, Customs, Other) -/

namespace AuGlobal
open TaxKernel TaxKernel.Global

def model0 : GlobalModel :=
  { base with
    families := Corporate.families ++ Social.families ++ Property.families ++ Transfers.families ++ Consumption.families ++ Customs.families ++ Other.families,
    absent := Corporate.absent ++ Social.absent ++ Property.absent ++ Transfers.absent ++ Consumption.absent ++ Customs.absent ++ Other.absent,
    notes := Corporate.notes ++ Social.notes ++ Property.notes ++ Transfers.notes ++ Consumption.notes ++ Customs.notes ++ Other.notes,
    unsupported := fun args g => Corporate.unsupported args g ++ Social.unsupported args g ++ Property.unsupported args g ++ Transfers.unsupported args g ++ Consumption.unsupported args g ++ Customs.unsupported args g ++ Other.unsupported args g }

/-- Kernel 2.5.0: income stacked on the 1.x income tax (`AuGlobal.Stack.rules`), added last. -/
def model : GlobalModel := model0.withStack Stack.rules

/-- Every 1.x output unchanged: the PIT is the 1.x exe's own line function on the household's input line. -/
theorem model0_pit (args : List String) (c : Canon) :
    (model0.computeGlobal args (CanonGlobal.ofCanon c)).pit = pitLine args c.raw := rfl

/-- The 1.x PIT line is unchanged by the stacking (kernel `withStack_pit`). -/
theorem model_pit (args : List String) (c : Canon) :
    (model.computeGlobal args (CanonGlobal.ofCanon c)).pit = (model0.computeGlobal args (CanonGlobal.ofCanon c)).pit :=
  withStack_pit model0 Stack.rules _ args _

end AuGlobal
