def families : List Family := [customsFamily [tariff] "5123 customs import duty (WTO IDB 2025)"]

def absent : List Absent := []

def notes : List String := ["AU 5123: WTO IDB 2025 applied tariff (customs/packs/au.json)"]

/-- Imported lines whose duty the tariff cannot settle (kernel `TariffRule.unknown`: grade C). -/
def unsupported (_ : List String) (g : CanonGlobal) : List String := tariff.unknown g

def custT (s : String) : CanonGlobal :=
  match Json.parse s with
  | .ok j => (match parseGlobal j with | .ok g => g | .error _ => default)
  | .error _ => default

-- clothing (hs 610910) from RU (no preference): customs value 12345, MFN 5 % = 12345 x 500 / 10000 = 617
#guard (tariff.charges (custT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"consumption\":[{\"good\":\"clothing\",\"amount\":24690,\"hs\":\"610910\",\"origin\":\"RU\",\"customsValue\":12345}]}")).map (·.due) == [617]
-- nonAlcoholic (hs 220210) from AE: Australia- Generalized System of Preferences (GSP) for developing countries in P 4 % instead of MFN 5 %: 12345 x 400 / 10000 = 493
#guard (tariff.charges (custT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"consumption\":[{\"good\":\"nonAlcoholic\",\"amount\":24690,\"hs\":\"220210\",\"origin\":\"AE\",\"customsValue\":12345}]}")).map (·.due) == [493]
-- imported without hs: no charge (grade C line)
#guard (tariff.charges (custT "{\"id\":\"t\",\"household\":{\"id\":\"t\",\"adults\":[{\"age\":40}]},\"consumption\":[{\"good\":\"clothing\",\"amount\":24690,\"imported\":true}]}")).map (·.due) == []

