/-!
# Certificates for drafting faults in Title 26: shared definitions

Each certificate in `TaxCode/Certs` restates one confirmed finding of the drafting checks (`TaxCode/Checks.lean`) as a
small proposition about literal data copied from the official OLRC USLM XML (release point 119-138), and proves it
with `decide +kernel`, so the kernel itself evaluates the claim against the evidence. The files are generated by
`tools/taxcode/certs.py` from the triaged findings; do not edit them by hand.

A provision's words are given as a list of characters (`List Char`), which the kernel evaluates directly; the same words
as a `String` (`String.ofList`) and in each certificate's docstring are for reading. The evidence is quoted, not
trusted: anyone can compare each literal with the XML at the identifier it names.
-/

namespace TaxCode.Certs

/-- One step of the parenthesis count used by `TaxCode.parenDepth`: depth, lowest depth reached, and quotation depth
(text inside curly quotation marks is quoted words, so its parentheses are not counted). -/
def parenStep : Int × Int × Nat → Char → Int × Int × Nat
  | (d, low, q), c =>
    if c = '“' then (d, low, q + 1)
    else if c = '”' then (d, low, q - 1)
    else if q > 0 then (d, low, q)
    else if c = '(' then (d + 1, low, q)
    else if c = ')' then (d - 1, min low (d - 1), q)
    else (d, low, q)

/-- `(final depth, lowest depth)` of the parentheses in a provision's words: the same count as `TaxCode.parenDepth`.
Balanced words end at depth 0 and never go below it. -/
def parenDepth (cs : List Char) : Int × Int :=
  let (d, low, _) := cs.foldl parenStep (0, 0, 0)
  (d, low)

/-- Parentheses balance: every one opened is closed, and none is closed before it is opened. -/
def Balanced (cs : List Char) : Prop := parenDepth cs = (0, 0)

instance (cs : List Char) : Decidable (Balanced cs) := inferInstanceAs (Decidable (parenDepth cs = (0, 0)))

end TaxCode.Certs
