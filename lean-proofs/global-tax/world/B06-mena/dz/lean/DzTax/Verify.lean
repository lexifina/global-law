import DzTax.Basic

/-! L1 loophole round (Africa / Middle East, 2026-11-20): the #guards behind FINDINGS.md "Verification".
Each guard runs `DzTax.country` on a contract household (the JSON line the exe reads) and checks a figure or the
difference between two households. Generated by world/loopholes/africa_mena/vgen.py from checks/DZ.json. -/

namespace DzTax.Verify
open TaxKernel Lean

def outOf (args : List String) (s : String) : Except String (Out × Canon) := do
  let j ← Json.parse s
  let c ← parseCanon j
  return (DzTax.country.computeWith args c, c)

def parses (s : String) : Bool := match Json.parse s >>= parseCanon with | .ok _ => true | .error _ => false

/-- A figure of the output: net, incomeTax, tax (income tax + surtaxes + local), social, benefits or a detail key. -/
def fig (args : List String) (field : String) (s : String) : Int :=
  match outOf args s with
  | .error _ => -999999999999
  | .ok (o, c) =>
    if field == "net" then o.net c.gross
    else if field == "incomeTax" then o.incomeTax
    else if field == "tax" then o.incomeTax + o.surtaxes.foldl (fun a p => a + p.2) 0 + o.localIncomeTax
    else if field == "social" then o.employeeSocial
    else if field == "benefits" then o.benefits
    else match o.detail.lookup field with
      | some j => (j.getInt?).toOption.getD (-999999999998)
      | none => -999999999997

-- F1 f1_rent_notch: CIDTA art. 104 II.2 (LF 2023): one dinar of rent over 1,800,000 costs 175,799 of net (L1-S: art. 85 25 % abatement)
#guard parses "{\"id\":\"a\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":0,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":1800000,\"charitable\":0,\"pensionContributions\":0}" && parses "{\"id\":\"b\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":0,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":1800001,\"charitable\":0,\"pensionContributions\":0}" && fig [] "net" "{\"id\":\"b\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":0,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":1800001,\"charitable\":0,\"pensionContributions\":0}" - fig [] "net" "{\"id\":\"a\",\"year\":2025,\"adults\":[{\"age\":40,\"wages\":0,\"selfEmployment\":0,\"pension\":0}],\"married\":false,\"children\":[],\"interest\":0,\"dividends\":0,\"capitalGains\":0,\"rentalIncome\":1800000,\"charitable\":0,\"pensionContributions\":0}" == -175799

